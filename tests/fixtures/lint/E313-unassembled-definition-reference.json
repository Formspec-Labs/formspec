{
  "$formspec": "1.0",
  "url": "urn:example:application",
  "version": "1.0.0",
  "status": "draft",
  "title": "Application",
  "items": [
    {
      "key": "section",
      "type": "group",
      "label": "Section",
      "children": [
        {
          "key": "cover",
          "type": "group",
          "label": "Cover",
