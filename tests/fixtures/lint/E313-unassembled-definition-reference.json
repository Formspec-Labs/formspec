        }
      ]
    },
    {
      "key": "copy",
      "type": "field",
      "label": "Copy",
      "dataType": "string"
    },
    {
      "key": "notes",
      "type": "field",
      "label": "Notes",
      "dataType": "string"
    }
  ],
  "binds": [
    {
      "path": "copy",
      "calculate": "$section.cover.c_name"
    }
  ]
}
