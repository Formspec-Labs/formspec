{
  "version": "0.1",
  "description": "Source-oriented UI Graph Policy semantic fixture families for future AppGraphValidator work. This fixture shape is conformance evidence only, not a public interchange schema.",
  "cases": [
    {
      "caseId": "valid-policy-graph",
      "family": "valid-policy-graph",
      "sources": {
        "policy": {
          "document": {
            "$formspecUiGraphPolicy": "0.1",
            "version": "1.0.0",
            "targetSurface": {
              "url": "https://example.gov/apps/intake/surfaces/respondent",
              "version": "1.0.0"
            },
            "localeKeyOwners": [
              {
                "keyPrefix": "$module.x-reviewer.",
                "moduleId": "x-reviewer"
              }
            ],
            "routePolicies": [
              {
                "routeId": "review",
                "a11y": {
                  "landmark": "main",
                  "keyboardNavigation": true
                },
                "responsive": {
                  "collapseOrder": ["summary", "details"]
                },
                "definitionVisibility": {
                  "hiddenDefinitionRefs": [
                    {
                      "url": "https://example.gov/forms/intake",
                      "version": "1.0.0"
                    }
                  ]
                }
              }
            ],
            "theme": {
              "assignments": [
                {
                  "widgetRef": {
                    "moduleId": "x-reviewer",
                    "widgetName": "x-review-panel"
                  },
                  "slot": "accent",
                  "token": "color.accent"
                }
              ]
            }
          }
        },
        "surface": {
          "ref": {
            "url": "https://example.gov/apps/intake/surfaces/respondent",
            "version": "1.0.0"
          },
          "document": {
            "$formspecSurface": "0.1",
            "id": "respondent",
            "entry": "review",
            "routes": [
              {
                "id": "review",
                "slots": [
                  {
                    "id": "summary",
                    "slotType": "definition-form",
                    "binding": {
                      "definitionRef": "https://example.gov/forms/intake"
                    }
                  },
                  {
                    "id": "details",
                    "slotType": "module-widget",
                    "binding": {
                      "moduleId": "x-reviewer",
                      "widgetName": "x-review-panel"
                    }
                  }
                ]
              }
            ]
          }
        },
        "locales": [
          {
            "sourceId": "locale-en",
            "document": {
              "$formspecLocale": "1.0",
              "locale": "en",
              "strings": {
                "$module.x-reviewer.heading": "Review"
              }
            }
          }
        ],
        "definitions": [
          {
            "sourceId": "definition-intake",
            "ref": {
              "url": "https://example.gov/forms/intake",
              "version": "1.0.0"
            }
          }
        ],
        "moduleResolution": {
          "admittedModules": ["x-reviewer"],
          "widgets": [
            {
              "moduleId": "x-reviewer",
              "widgetName": "x-review-panel",
              "tokenSlots": ["accent"]
            }
          ]
        },
        "theme": {
          "tokens": ["color.accent"]
        }
      },
      "expectedDiagnostics": []
    },
