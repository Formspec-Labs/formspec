{
  "$formspecSurface": "0.1",
  "id": "p2-module-widget-fixture",
  "title": "P2 module-widget binding fixture",
  "modules": [
    { "id": "x-formspec-surface",       "version": "^0.1.0" },
    { "id": "x-formspec-presentation",  "version": "^0.1.0" },
    { "id": "x-formspec-conversation",  "version": "^0.1.0" }
  ],
  "entry": "home",
  "routes": [
    {
      "id": "home",
      "path": "/",
      "title": "Home",
      "slots": [
        {
          "id": "shell",
          "slotType": "module-widget",
          "position": "header",
          "binding": {
            "moduleId": "x-formspec-presentation",
            "widgetName": "Shell"
          }
        },
        {
          "id": "thread",
          "slotType": "module-widget",
          "position": "main",
          "binding": {
            "moduleId": "x-formspec-conversation",
            "widgetName": "ChatThread"
          }
        }
      ]
    }
  ]
}
