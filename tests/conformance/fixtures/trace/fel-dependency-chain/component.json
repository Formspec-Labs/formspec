    "unitRef": "incomeEntry",
    "children": [
      { "id": "hhInput", "component": "NumberInput", "bind": "householdIncome", "unitRef": "incomeEntry" },
      { "id": "grossInput", "component": "NumberInput", "bind": "grossIncome", "unitRef": "incomeEntry" },
      { "id": "stdInput", "component": "NumberInput", "bind": "standardDeduction", "unitRef": "incomeEntry" },
      { "id": "depInput", "component": "NumberInput", "bind": "dependents", "unitRef": "incomeEntry" },
      { "id": "eligOut", "component": "Text", "bind": "eligibility" },
      { "id": "submitBtn", "component": "ActionButton", "actionRef": "submitEligibility" }
    ]
  }
}
