{
  "$formspecComponent": "1.1",
  "url": "https://example.gov/forms/eligibility/components/main",
  "version": "1.0.0",
  "targetDefinition": { "url": "https://example.gov/forms/eligibility", "compatibleVersions": ">=1.0.0 <2.0.0" },
  "tree": {
