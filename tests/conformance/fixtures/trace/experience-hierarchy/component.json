{
  "$formspecComponent": "1.1",
  "url": "https://example.gov/forms/grant/components/main",
  "version": "1.0.0",
  "targetDefinition": { "url": "https://example.gov/forms/grant", "compatibleVersions": ">=1.0.0 <2.0.0" },
  "tree": {
    "id": "root",
    "component": "Stack",
    "children": [
      { "id": "nameInput", "component": "TextInput", "bind": "applicantName", "unitRef": "identity" },
      { "id": "incomeInput", "component": "NumberInput", "bind": "annualIncome", "unitRef": "income" },
      { "id": "notesInput", "component": "TextInput", "bind": "reviewerNotes", "unitRef": "reviewNotes", "maxLines": 4 },
      { "id": "submitBtn", "component": "ActionButton", "actionRef": "submitGrant" }
    ]
  }
}
