{
  "id": "ui-graph-policy-hidden-definitions",
  "description": "Executable AppGraphValidator conformance for UI Graph Policy hidden Definition semantic families.",
  "handles": {
    "manifest": {
      "slot": "app",
      "artifactKind": "appManifest",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/bundleManifest/2.2",
      "source": "memory://app",
      "document": {
        "$formspecApp": "2.2",
        "id": "intake-app"
      }
    },
    "surface-respondent": {
      "slot": "surfaces[0]",
      "artifactKind": "surface",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/surface/0.1",
      "source": "memory://surface/respondent",
      "ref": {
        "url": "https://example.gov/apps/intake/surfaces/respondent",
        "version": "1.0.0"
      },
      "document": {
        "$formspecSurface": "0.1",
        "id": "respondent",
        "entry": "review",
        "routes": [
          {
            "id": "review",
            "path": "/review",
            "slots": [
              {
                "id": "summary",
                "slotType": "definition-form",
                "binding": {
                  "definitionRef": "https://example.gov/forms/intake"
                }
              }
            ]
          },
          {
            "id": "done",
            "path": "/done",
            "slots": [
              {
                "id": "confirmation",
                "slotType": "static-content",
                "binding": {
                  "kind": "text",
                  "content": "Done"
                }
              }
            ]
          }
        ]
      }
    },
