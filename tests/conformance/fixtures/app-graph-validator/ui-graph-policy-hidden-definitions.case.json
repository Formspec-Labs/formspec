          {
            "id": "review",
            "path": "/review",
            "slots": [
              {
                "id": "summary",
                "slotType": "static-content",
                "binding": {
                  "kind": "text",
                  "content": "Review"
                }
              }
            ]
          },
          {
            "id": "done",
            "path": "/done",
            "slots": [
              {
                "id": "confirmation",
                "slotType": "static-content",
