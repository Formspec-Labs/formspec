  "cases": [
    {
      "id": "valid-hidden-definition",
      "description": "A hidden Definition ref resolves to a loaded Definition and route-local definition-form slot.",
      "request": {
        "manifest": "manifest",
        "artifacts": {
          "surfaces": ["surface-respondent"],
          "definitions": ["definition-intake-v1"]
        },
        "hostEvidence": {
          "uiGraphPolicies": ["valid-hidden-definition"]
        }
      },
      "expected": {
        "ok": true,
        "summary": {
          "artifacts": 3,
          "loadedArtifacts": 3,
          "schemaFailures": 0,
          "unvalidatedArtifacts": 0,
          "graphErrors": 0,
          "errors": 0,
          "warnings": 0,
          "infos": 0,
          "importedDiagnostics": 0,
          "unsupportedFeatures": 0,
          "skippedPhases": 0
        },
        "diagnostics": []
      }
    },
    {
      "id": "unresolved-hidden-definition",
      "description": "A hidden Definition ref must resolve to a loaded Definition handle by ref URL.",
      "request": {
        "manifest": "manifest",
        "artifacts": {
          "surfaces": ["surface-respondent"]
        },
        "hostEvidence": {
          "uiGraphPolicies": ["unresolved-hidden-definition"]
        }
      },
      "expected": {
        "ok": false,
        "summary": {
          "artifacts": 2,
          "loadedArtifacts": 2,
          "schemaFailures": 0,
          "unvalidatedArtifacts": 0,
          "graphErrors": 1,
          "errors": 1,
          "warnings": 0,
          "infos": 0,
          "importedDiagnostics": 0,
          "unsupportedFeatures": 0,
          "skippedPhases": 0
        },
        "diagnostics": [
          {
            "code": "UI-POLICY-HIDDEN-DEFINITION-REF",
            "primarySource": {
              "artifactSlot": "hostEvidence.uiGraphPolicies[0]",
              "source": "host://policy/unresolved-hidden-definition",
              "jsonPointer": "/routePolicies/0/definitionVisibility/hiddenDefinitionRefs/0/url"
            },
            "details": {
              "routeId": "review",
              "definitionRef": "https://example.gov/forms/intake",
              "reason": "unresolved-definition"
            }
          }
        ]
      }
    },
    {
      "id": "hidden-definition-not-route-local",
      "description": "A hidden Definition ref must be present as a definition-form slot on the target route.",
