      "document": {
        "$formspecUiGraphPolicy": "0.1",
        "version": "1.0.0",
        "targetSurface": {
          "url": "https://example.gov/apps/intake/surfaces/respondent"
        },
        "localeKeyOwners": [
          {
            "keyPrefix": "$module.x-reviewer.",
            "moduleId": "x-helper"
          }
        ],
        "routePolicies": [
          {
            "routeId": "review"
          }
        ]
      }
    },
    "no-module-keys": {
      "schemaId": "https://formspec.org/schemas/uiGraphPolicy/0.1",
      "source": "host://policy/no-module-keys",
      "document": {
        "$formspecUiGraphPolicy": "0.1",
        "version": "1.0.0",
        "targetSurface": {
