    "overlap-prefix-collision": {
      "schemaId": "https://formspec.org/schemas/uiGraphPolicy/0.1",
      "source": "host://policy/overlap-prefix-collision",
      "document": {
        "$formspecUiGraphPolicy": "0.1",
        "version": "1.0.0",
        "targetSurface": {
          "url": "https://example.gov/apps/intake/surfaces/respondent"
        },
        "localeKeyOwners": [
          {
            "keyPrefix": "$module.x-reviewer.",
            "moduleId": "x-reviewer"
          },
          {
            "keyPrefix": "$module.x-reviewer.case.",
            "moduleId": "x-supervisor"
          }
        ],
        "routePolicies": [
          {
            "routeId": "review"
          }
        ]
      }
    },
    "same-module-overlap": {
      "schemaId": "https://formspec.org/schemas/uiGraphPolicy/0.1",
