  "cases": [
    {
      "id": "valid-locale-owner",
      "description": "A loaded Locale $module.* key covered by a policy owner emits no diagnostics.",
      "request": {
        "manifest": "manifest",
        "artifacts": {
          "surfaces": ["surface-respondent"],
          "locales": ["locale-reviewer"]
        },
        "hostEvidence": {
          "uiGraphPolicies": ["valid-owner"]
        }
      },
      "expected": {
        "ok": true,
        "summary": {
          "artifacts": 3,
          "loadedArtifacts": 3,
          "schemaFailures": 0,
          "unvalidatedArtifacts": 0,
          "graphErrors": 0,
          "errors": 0,
          "warnings": 0,
          "infos": 0,
          "importedDiagnostics": 0,
          "unsupportedFeatures": 0,
          "skippedPhases": 0
        },
        "diagnostics": []
      }
    },
    {
      "id": "missing-locale-owner",
      "description": "A loaded Locale $module.* key must match a declared owner prefix.",
      "request": {
        "manifest": "manifest",
        "artifacts": {
          "surfaces": ["surface-respondent"],
          "locales": ["locale-helper"]
        },
        "hostEvidence": {
          "uiGraphPolicies": ["missing-owner"]
        }
      },
      "expected": {
        "ok": false,
        "summary": {
          "artifacts": 3,
          "loadedArtifacts": 3,
          "schemaFailures": 0,
          "unvalidatedArtifacts": 0,
          "graphErrors": 1,
          "errors": 1,
          "warnings": 0,
          "infos": 0,
          "importedDiagnostics": 0,
          "unsupportedFeatures": 0,
          "skippedPhases": 0
        },
        "diagnostics": [
          {
            "code": "LOCALE-KEY-OWNER",
            "primarySource": {
              "artifactSlot": "locales[0]",
              "artifactKind": "locale",
              "source": "memory://locale/helper",
              "jsonPointer": "/strings/$module.x-helper.heading",
              "ref": {
                "url": "https://example.gov/apps/intake/locales/en-us",
                "version": "1.0.0",
                "locale": "en-US"
              }
            },
            "relatedSources": [
              {
                "artifactSlot": "hostEvidence.uiGraphPolicies[0]",
                "source": "host://policy/missing-owner",
                "jsonPointer": "/localeKeyOwners"
              }
            ],
            "details": {
              "localeKey": "$module.x-helper.heading"
            }
          }
        ]
      }
    },
    {
      "id": "exact-prefix-collision",
      "description": "Two different modules may not claim the same Locale key prefix.",
      "request": {
        "manifest": "manifest",
        "artifacts": {
          "surfaces": ["surface-respondent"]
        },
        "hostEvidence": {
          "uiGraphPolicies": ["exact-prefix-collision"]
        }
      },
      "expected": {
        "ok": false,
        "summary": {
          "artifacts": 2,
          "loadedArtifacts": 2,
          "schemaFailures": 0,
          "unvalidatedArtifacts": 0,
          "graphErrors": 1,
          "errors": 1,
          "warnings": 0,
          "infos": 0,
          "importedDiagnostics": 0,
          "unsupportedFeatures": 0,
          "skippedPhases": 0
        },
        "diagnostics": [
          {
            "code": "LOCALE-KEY-OWNER-COLLISION",
            "primarySource": {
              "artifactSlot": "hostEvidence.uiGraphPolicies[0]",
              "source": "host://policy/exact-prefix-collision",
              "jsonPointer": "/localeKeyOwners/1/keyPrefix"
            },
            "relatedSources": [
              {
                "artifactSlot": "hostEvidence.uiGraphPolicies[0]",
                "source": "host://policy/exact-prefix-collision",
