            "details": {
              "keyPrefix": "$module.x-reviewer.case.",
              "moduleId": "x-supervisor",
              "conflictingKeyPrefix": "$module.x-reviewer.case.",
              "conflictingModuleId": "x-reviewer"
            }
          }
        ]
      }
    },
    {
      "id": "overlap-prefix-collision",
