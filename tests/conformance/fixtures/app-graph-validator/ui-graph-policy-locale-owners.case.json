{
  "id": "ui-graph-policy-locale-owners",
  "description": "Executable AppGraphValidator conformance for UI Graph Policy Locale-owner semantic families.",
  "handles": {
    "manifest": {
      "slot": "app",
      "artifactKind": "appManifest",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/bundleManifest/2.2",
      "source": "memory://app",
      "document": {
        "$formspecApp": "2.2",
        "id": "intake-app"
      }
    },
    "surface-respondent": {
      "slot": "surfaces[0]",
      "artifactKind": "surface",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/surface/0.1",
      "source": "memory://surface/respondent",
      "ref": {
        "url": "https://example.gov/apps/intake/surfaces/respondent",
        "version": "1.0.0"
      },
      "document": {
        "$formspecSurface": "0.1",
        "id": "respondent",
        "entry": "review",
        "routes": [
          {
            "id": "review",
            "path": "/review",
            "slots": [
              {
                "id": "summary",
                "slotType": "definition-form",
                "binding": {
                  "definitionRef": "https://example.gov/forms/intake"
                }
              }
            ]
          }
        ]
      }
    },
    "locale-reviewer": {
      "slot": "locales[0]",
      "artifactKind": "locale",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/locale/1.0",
      "source": "memory://locale/reviewer",
      "ref": {
        "url": "https://example.gov/apps/intake/locales/en-us",
        "version": "1.0.0",
        "locale": "en-US"
      },
      "document": {
        "$formspecLocale": "1.0",
        "version": "1.0.0",
        "locale": "en-US",
        "targetDefinition": {
          "url": "https://example.gov/forms/intake"
        },
        "strings": {
          "$module.x-reviewer.heading": "Review",
          "$form.title": "Intake"
        }
      }
    },
    "locale-helper": {
      "slot": "locales[0]",
      "artifactKind": "locale",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/locale/1.0",
      "source": "memory://locale/helper",
      "ref": {
        "url": "https://example.gov/apps/intake/locales/en-us",
        "version": "1.0.0",
        "locale": "en-US"
      },
      "document": {
        "$formspecLocale": "1.0",
        "version": "1.0.0",
        "locale": "en-US",
        "targetDefinition": {
          "url": "https://example.gov/forms/intake"
        },
        "strings": {
          "$module.x-helper.heading": "Helper"
        }
      }
    },
    "locale-core-only": {
      "slot": "locales[0]",
      "artifactKind": "locale",
      "status": "loaded",
      "schemaId": "https://formspec.org/schemas/locale/1.0",
      "source": "memory://locale/core-only",
      "ref": {
        "url": "https://example.gov/apps/intake/locales/en-us",
        "version": "1.0.0",
        "locale": "en-US"
      },
      "document": {
        "$formspecLocale": "1.0",
        "version": "1.0.0",
        "locale": "en-US",
        "targetDefinition": {
          "url": "https://example.gov/forms/intake"
        },
        "strings": {
          "$form.title": "Intake",
          "$component.submit.label": "Submit"
        }
      }
    }
  },
  "policies": {
    "valid-owner": {
      "schemaId": "https://formspec.org/schemas/uiGraphPolicy/0.1",
      "source": "host://policy/valid-owner",
      "document": {
        "$formspecUiGraphPolicy": "0.1",
        "version": "1.0.0",
        "targetSurface": {
          "url": "https://example.gov/apps/intake/surfaces/respondent"
        },
        "localeKeyOwners": [
          {
            "keyPrefix": "$module.x-reviewer.",
            "moduleId": "x-reviewer"
          }
        ],
        "routePolicies": [
          {
            "routeId": "review"
          }
        ]
      }
    },
    "missing-owner": {
      "schemaId": "https://formspec.org/schemas/uiGraphPolicy/0.1",
      "source": "host://policy/missing-owner",
