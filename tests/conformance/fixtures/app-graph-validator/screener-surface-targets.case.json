    "manifest.base": {
      "slot": "app",
      "artifactKind": "appManifest",
      "status": "loaded",
      "source": "memory://app",
      "document": {
        "$formspecBundle": "2.3",
        "id": "https://example.gov/apps/screened-intake",
        "version": "1.0.0",
        "definitions": [],
        "screeners": [
          {
            "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
            "version": "1.0.0"
          }
        ],
        "surfaces": [
          {
            "url": "https://example.gov/apps/screened-intake/surfaces/respondent",
            "version": "1.0.0"
          }
        ]
      }
    },
    "manifest.no-screeners": {
      "slot": "app",
      "artifactKind": "appManifest",
      "status": "loaded",
      "source": "memory://app/no-screeners",
      "document": {
        "$formspecBundle": "2.3",
        "id": "https://example.gov/apps/unscreened-intake",
        "version": "1.0.0",
        "definitions": [],
        "surfaces": [
          {
            "url": "https://example.gov/apps/screened-intake/surfaces/respondent",
            "version": "1.0.0"
          }
        ]
      }
    },
    "screener.valid": {
      "slot": "screeners[0]",
      "artifactKind": "screener",
      "status": "loaded",
      "source": "memory://screener/valid",
      "ref": {
        "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
        "version": "1.0.0"
      },
      "document": {
        "$formspecScreener": "1.0",
        "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
        "version": "1.0.0",
        "title": "Eligibility",
        "items": [],
        "evaluation": [
          {
            "id": "route",
            "strategy": "first-match",
            "routes": [
              {
                "condition": "true",
                "target": "surface:apply",
                "label": "Apply"
              }
            ]
          }
        ]
      }
    },
    "screener.missing-route": {
      "slot": "screeners[0]",
      "artifactKind": "screener",
      "status": "loaded",
