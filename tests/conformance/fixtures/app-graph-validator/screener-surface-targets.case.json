        "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
        "version": "1.0.0"
      },
      "document": {
        "$formspecScreener": "1.0",
        "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
        "version": "1.0.0",
        "title": "Eligibility",
        "items": [],
        "evaluation": [
          {
            "id": "route",
            "strategy": "first-match",
            "routes": [
              {
                "condition": "true",
                "target": "surface:missing",
                "label": "Missing"
              }
            ]
          }
        ]
      }
    },
    "screener.ambiguous-route": {
      "slot": "screeners[0]",
      "artifactKind": "screener",
      "status": "loaded",
      "source": "memory://screener/ambiguous-route",
      "ref": {
        "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
        "version": "1.0.0"
      },
      "document": {
        "$formspecScreener": "1.0",
        "url": "https://example.gov/apps/screened-intake/screeners/eligibility",
        "version": "1.0.0",
        "title": "Eligibility",
        "items": [],
        "evaluation": [
          {
            "id": "route",
            "strategy": "first-match",
            "routes": [
              {
                "condition": "true",
                "target": "surface:shared",
                "label": "Shared"
              }
            ]
          }
        ]
      }
    },
    "surface.respondent": {
      "slot": "surfaces[0]",
      "artifactKind": "surface",
      "status": "loaded",
      "source": "memory://surface/respondent",
      "ref": {
        "url": "https://example.gov/apps/screened-intake/surfaces/respondent",
        "version": "1.0.0"
      },
      "document": {
        "$formspecSurface": "0.1",
        "id": "respondent",
        "entry": "apply",
