        "version": "1.0.0"
      },
      "document": {
        "$formspecSurface": "0.1",
        "id": "secondary",
        "entry": "shared",
        "routes": [
          {
            "id": "shared",
            "path": "/secondary/shared",
            "slots": []
          }
        ]
      }
    }
  },
  "cases": [
    {
      "id": "valid-screener-surface-target",
      "description": "A manifest-associated Screener target resolves to exactly one loaded Surface route.",
      "request": {
        "manifest": "manifest.base",
        "artifacts": {
          "screeners": ["screener.valid"],
          "surfaces": ["surface.respondent"]
        }
      },
      "expected": {
        "ok": true,
        "summary": {
          "artifacts": 3,
          "loadedArtifacts": 3,
          "schemaFailures": 0,
          "unvalidatedArtifacts": 0,
          "graphErrors": 0,
          "errors": 0,
          "warnings": 0,
          "infos": 0,
          "importedDiagnostics": 0,
          "unsupportedFeatures": 0,
          "skippedPhases": 0
        },
        "diagnostics": []
      }
    },
    {
