    "surfaceWidgetUseName": "x-acme-surface-widget-case-status",
    "responseActionUseName": "x-escalate",
    "uiPolicyWidgetUseName": "x-review-panel",
    "fallbackSurfaceWidgetUseName": "UnmappedCaseStatus",
    "fallbackDiagnosticCode": "MODULE-CONTRIBUTION-MISSING",
    "contributionNames": [
      "x-acme-surface-widget-case-status",
      "x-escalate",
      "x-review-panel"
    ],
    "absentAppGraphDiagnostics": [
      "THEME-TOKEN-WIDGET",
      "THEME-TOKEN-SLOT",
      "THEME-TOKEN-CATEGORY"
    ]
