        "version": "1.0.0",
        "modules": [
          { "id": "x-acme-surface", "version": "1.0.0" },
          { "id": "x-actions", "version": "1.0.0" },
          { "id": "x-reviewer", "version": "1.0.0" }
        ]
      }
    },
    "handles": [
      {
        "slot": "surfaces[0]",
        "artifactKind": "surface",
        "status": "loaded",
        "source": "memory://surface/review",
        "ref": {
          "url": "https://example.gov/apps/intake/surfaces/review",
          "version": "1.0.0"
