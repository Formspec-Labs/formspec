{
  "$formspecIdentityBindingProfile": "1.0",
  "version": "1.0.0",
  "profileId": "urn:formspec:identity-binding-profile:springfield:benefits-renewal:1",
  "targetDefinition": {
    "url": "https://springfield.gov/forms/benefits-renewal",
    "compatibleVersions": ">=1.0.0 <2.0.0"
  },
  "profiles": [
    {
      "id": "respondent-passkey-signature",
      "purpose": "respondent-signature",
      "subjectKind": "human",
      "bindingMethod": "webauthn",
      "assuranceFloor": "high",
      "nistAssuranceFloor": {
        "ial": "IAL2",
        "aal": "AAL2",
        "fal": null
      },
      "identityProviderRef": "https://springfield.gov/identity/passkeys",
      "evidenceBindings": {
        "identityClaimEvidenceRef": "IdentityClaim.evidenceRef",
        "authoredSignatureIdentityBinding": "AuthoredSignature.identityBinding",
        "externalAttestationRef": "AuthoredSignature.identityBinding.externalAttestationRef",
        "ledgerAttestationEvidenceRef": "RespondentLedger.identityAttestation.evidenceRef"
      },
      "webAuthn": {
        "rpId": "springfield.gov",
        "origins": ["https://springfield.gov"],
        "userVerification": "required",
        "credentialRegistryRef": "https://springfield.gov/identity/passkeys/credentials",
        "authenticatorAttachment": "either",
        "attestationConveyance": "none",
        "duressCredentialSupport": "dual-passkey-convention",
        "challengeBinding": {
          "domainSeparator": "formspec.webauthn.challenge.v1",
          "challengeEncoding": "base64url(sha-256(jcs(canonicalChallengeStructure)))",
          "signedPayloadDigestBinding": "AuthoredSignature.signedPayload.digest",
          "includeOrigin": true,
          "includeRpId": true,
          "includeSignerId": true,
          "includeSigningIntent": true,
          "includeNonce": true,
          "includePostureSnapshot": true,
          "includeSignatureMethodRegistrySnapshot": true
        },
        "assertionBinding": {
          "signatureMethod": "urn:formspec:sig-method:webauthn-fido2@1",
          "signatureArtifactKind": "webauthn",
          "validationArtifactKind": "webauthn-server-attestation",
          "responseIdentityBindingMethod": "webauthn"
        }
      }
    }
  ]
}
