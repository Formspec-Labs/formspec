{
  "$formspecDataSources": "1.0",
  "id": "https://example.gov/apps/data-aware-workspace/data-sources",
  "version": "1.0.0",
  "sources": [
    {
      "id": "route:active-matter",
      "kind": "route-params",
      "owner": "formspec",
      "scope": "route",
      "availability": {
        "level": "slot",
