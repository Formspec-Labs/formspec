{
  "$formspec": "1.0",
  "url": "https://example.org/forms/grant",
  "version": "1.0.0",
  "status": "active",
  "title": "Grant Application",
  "description": "Funding request",
  "formPresentation": {
    "pageMode": "wizard"
  },
  "items": [
    {
      "key": "organization",
      "type": "group",
      "label": "Organization",
      "children": [
        {
          "key": "name",
          "type": "field",
          "dataType": "string",
          "label": "Organization Name",
          "semanticType": "x-concept-org-name"
        },
        {
          "key": "ein",
          "type": "field",
          "dataType": "string",
          "label": "Employer Identification Number",
          "semanticType": "x-concept-org-ein"
        }
      ]
    },
    {
      "key": "contactEmail",
      "type": "field",
      "dataType": "string",
      "label": "Contact Email",
      "presentation": { "widgetHint": "TextInput" }
    },
    {
      "key": "details",
      "type": "group",
      "label": "Project Details",
      "children": [
        {
          "key": "summary",
          "type": "field",
          "dataType": "string",
          "label": "Project Summary"
        }
      ]
    },
    {
      "key": "budgetItems",
      "type": "group",
      "label": "Budget Items",
      "repeatable": true,
      "minRepeat": 1,
      "maxRepeat": 5,
      "children": [
        {
          "key": "description",
          "type": "field",
          "dataType": "string",
          "label": "Item Description"
        },
        {
          "key": "amount",
          "type": "field",
          "dataType": "decimal",
          "label": "Amount"
        }
      ]
    },
    {
      "key": "derivedScore",
      "type": "field",
      "dataType": "integer",
      "label": "Derived Score"
    }
  ],
  "binds": [
    { "path": "organization.name", "required": "true" },
    { "path": "organization.ein", "required": "true" },
    { "path": "contactEmail", "required": "true" },
    { "path": "budgetItems[*].description", "required": "true" },
    { "path": "budgetItems[*].amount", "required": "true" },
    { "path": "derivedScore", "calculate": "1", "readonly": "true" }
  ]
}
