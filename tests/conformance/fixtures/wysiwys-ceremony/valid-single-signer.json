{
  "$formspecWysiwysCeremony": "1.0",
  "version": "1.0.0",
  "targetDefinition": {
    "url": "https://springfield.gov/forms/benefits-renewal",
    "compatibleVersions": ">=1.0.0 <2.0.0"
  },
  "signatureSurfaces": [
    {
      "surfaceRef": "applicant_signature_box",
      "signatureSurfaceContract": "ADR-0136.SignatureSurface",
      "surfaceName": "Benefits renewal signature page",
      "preimageBinding": {
        "documentArtifactRef": "pdf-preview-001",
        "documentArtifactContract": "ADR-0136.DocumentArtifact",
        "hashField": "presentationHash",
        "authoredSignatureBinding": "AuthoredSignature.documentHash",
        "renderingServiceContract": "ADR-0141.RenderingService"
      },
      "requirements": {
        "displayExactPreimage": true,
        "scrollGate": {
          "required": true,
          "completion": "end-of-surface"
        },
        "affirmativeAction": {
          "mode": "per-field"
        },
        "singleClickAdoptAndSign": "forbidden",
        "bulkApply": "forbidden",
        "typedNameAsSoleAct": "forbidden"
      },
      "fields": [
        {
          "fieldRef": "/signatures/applicant",
          "act": "sign",
          "required": true,
          "label": "Applicant signature"
        }
      ]
    }
  ]
}
