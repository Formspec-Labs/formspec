    { "type": "field", "key": "topic", "dataType": "string", "label": "Topic" },
    { "type": "field", "key": "outcome", "dataType": "string", "label": "Outcome" },
    { "type": "field", "key": "partner", "dataType": "string", "label": "Partner" },
    { "type": "field", "key": "attendance", "dataType": "integer", "label": "Attendance" }
