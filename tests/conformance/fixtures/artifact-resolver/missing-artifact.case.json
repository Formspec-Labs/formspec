{
  "id": "missing-artifact",
  "description": "Emits a missing handle and diagnostic when the host loader cannot find a declared sibling.",
  "manifest": {
    "$formspecBundle": "2.2",
    "id": "https://example.gov/apps/missing-artifact",
    "version": "1.0.0",
    "definitions": [
      {
        "url": "https://example.gov/apps/missing-artifact/definition",
        "version": "1.0.0"
      }
    ]
  },
  "documents": {},
  "loader": {
    "missing": ["https://example.gov/apps/missing-artifact/definition"]
  },
  "expected": {
    "ok": false,
    "summary": {
      "declaredRefs": 1,
      "loadedArtifacts": 0,
      "missingArtifacts": 1,
      "errors": 1
    },
    "diagnostics": [
      {
        "code": "ARTIFACT-MISSING",
        "severity": "error"
      }
    ],
    "loaderCalls": [
      "definitions[0]:definition:https://example.gov/apps/missing-artifact/definition"
    ],
    "handles": [
      {
        "slot": "definitions[0]",
        "artifactKind": "definition",
        "status": "missing"
      }
    ]
  }
}
