{
  "id": "invalid-unknown-values-key",
  "description": "`dashboard` is not a `Route.routeClass` value. A rule keyed on a value the vocabulary does not contain protects nothing and hides the typo.",
  "adrRow": "§5.1 a `values` key naming a value outside the handle's closed vocabulary → `posture-config-invalid`.",
  "postureDeclaration": {
    "$postureDeclaration": "1.0",
    "url": "https://example.org/posture/adr-0152/invalid-unknown-values-key.json",
    "version": "1.0.0",
    "signaturePolicy": {
      "allowedMethods": [
        "urn:formspec:sig-method:ed25519-cose-sign1@1"
      ],
      "minimumPrimitiveVerification": "verified",
      "receiptSigningRequired": true
    },
    "allowedActors": [
      "urn:formspec:actor:human:tenant-admin:acme",
      "urn:formspec:actor:ai-agent:wireframes"
    ],
    "extensions": {
      "x-formspec-actor-scope": {
        "$actorScope": "1.0",
        "protects": [
          {
            "vocabulary": "surface.routeClass",
            "writableBy": {
              "kinds": [
                "human"
              ]
            },
            "values": {
              "dashboard": {
                "kinds": [
                  "human"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "expectSchemaValid": false,
  "expectedAdmission": "posture-config-invalid"
}
