{
  "$formspec": "1.0",
  "url": "urn:test:conformance:parity:repeat-counts",
  "version": "1.0.0",
  "title": "Row counts",
  "status": "active",
  "items": [
    {
      "key": "rows",
      "type": "group",
      "label": "Rows",
      "children": [
        {
          "key": "a",
          "type": "field",
          "dataType": "string",
          "label": "A"
        }
      ],
      "repeatable": true
    },
    {
      "key": "m",
      "type": "field",
      "dataType": "integer",
      "label": "M"
    },
    {
      "key": "k",
      "type": "field",
      "dataType": "integer",
      "label": "K"
    },
    {
      "key": "n",
      "type": "field",
      "dataType": "integer",
      "label": "N"
    }
  ],
  "binds": [
    {
      "path": "m",
      "calculate": "count($rows[*])"
    },
    {
      "path": "k",
      "calculate": "count($rows[*].a)"
    },
    {
      "path": "n",
      "calculate": "count($rows)"
    }
  ]
}
