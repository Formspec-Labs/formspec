          "key": "sourceId",
          "label": "Source ID",
          "prePopulate": {
            "instance": "records",
            "path": "id"
          }
        },
        {
          "type": "group",
          "key": "nested",
          "label": "Nested rows",
          "repeatable": true,
          "minRepeat": 1,
          "seedFrom": {
            "instance": "records",
            "path": "list",
            "where": "invalid +"
          },
          "children": []
        }
      ],
      "maxRepeat": 2
    }
  ],
