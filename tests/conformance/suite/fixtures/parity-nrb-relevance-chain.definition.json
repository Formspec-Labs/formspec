{
  "$formspec": "1.0",
  "url": "urn:test:conformance:parity:nrb-relevance-chain",
  "version": "1.0.0",
  "title": "Cascading relevance",
  "status": "active",
  "items": [
    { "key": "x", "type": "field", "dataType": "integer", "label": "X" },
    { "key": "y", "type": "field", "dataType": "integer", "label": "Y" },
    { "key": "z", "type": "field", "dataType": "integer", "label": "Z" }
  ],
  "binds": [
    { "path": "x", "relevant": "false" },
    { "path": "y", "relevant": "present($x)" },
    { "path": "z", "relevant": "present($y)" }
  ]
}
