{
  "id": "core.item-text-repeat-row-scope",
  "kind": "ITEM_TEXT",
  "specRefs": [
    "Core §4.2.1",
    "Locale §3.3.2 repeat children interpolate in their instance scope"
  ],
  "definitionPath": "tests/conformance/suite/fixtures/item-text.definition.json",
  "inputData": {
    "qty": 3,
    "rows": [
      {
        "name": "Alpha"
      },
      {
        "name": "Beta"
      }
    ]
  },
  "expected": {
    "rows[0].name": {
      "label": "Name 1",
      "hint": "Row 1 of 2",
      "description": "Before:  / after: Beta"
    },
    "rows[0].summary": {
      "label": "Row 1: Alpha"
    },
    "rows[1].name": {
      "label": "Name 2",
      "hint": "Row 2 of 2",
      "description": "Before: Alpha / after: "
    },
    "rows[1].summary": {
      "label": "Row 2: Beta"
    }
  }
}
