{
  "$formspecTokenRegistry": "1.0",
  "description": "Formspec platform token catalog — tokens consumed by the default CSS skin.",
  "contrastPairs": [
    {
      "id": "body-text-on-page",
      "foregroundToken": "color.foreground",
      "backgroundToken": "color.background",
      "usage": "normalText"
    },
    {
      "id": "body-text-on-card",
      "foregroundToken": "color.foreground",
      "backgroundToken": "color.card",
      "usage": "normalText"
    },
    {
      "id": "muted-text-on-page",
      "foregroundToken": "color.muted",
      "backgroundToken": "color.background",
      "usage": "normalText"
    },
    {
      "id": "muted-text-on-card",
      "foregroundToken": "color.muted",
      "backgroundToken": "color.card",
      "usage": "normalText"
    },
    {
      "id": "subtle-text-on-page",
      "foregroundToken": "color.mutedForeground",
      "backgroundToken": "color.background",
      "usage": "normalText"
    },
    {
      "id": "subtle-text-on-card",
      "foregroundToken": "color.mutedForeground",
      "backgroundToken": "color.card",
      "usage": "normalText"
    },
    {
      "id": "primary-text-on-page",
      "foregroundToken": "color.primary",
      "backgroundToken": "color.background",
      "usage": "normalText"
    },
    {
      "id": "primary-text-on-card",
      "foregroundToken": "color.primary",
      "backgroundToken": "color.card",
      "usage": "normalText"
    },
    {
      "id": "primary-label-on-primary",
      "foregroundToken": "color.primaryForeground",
      "backgroundToken": "color.primary",
      "usage": "normalText"
    },
    {
      "id": "success-label-on-success",
      "foregroundToken": "color.primaryForeground",
      "backgroundToken": "color.success",
      "usage": "normalText"
    },
    {
      "id": "danger-label-on-danger",
      "foregroundToken": "color.primaryForeground",
      "backgroundToken": "color.error",
      "usage": "normalText"
    },
    {
      "id": "error-text-on-page",
      "foregroundToken": "color.error",
      "backgroundToken": "color.background",
      "usage": "normalText"
    },
    {
      "id": "error-text-on-card",
      "foregroundToken": "color.error",
      "backgroundToken": "color.card",
      "usage": "normalText"
    },
    {
      "id": "input-boundary-on-page",
      "foregroundToken": "color.input",
      "backgroundToken": "color.background",
      "usage": "uiComponent"
    },
    {
      "id": "input-boundary-on-card",
      "foregroundToken": "color.input",
      "backgroundToken": "color.card",
      "usage": "uiComponent"
    },
    {
      "id": "focus-indicator-on-page",
      "foregroundToken": "color.ring",
      "backgroundToken": "color.background",
      "usage": "uiComponent"
    },
    {
      "id": "focus-indicator-on-card",
      "foregroundToken": "color.ring",
      "backgroundToken": "color.card",
      "usage": "uiComponent"
    },
    {
      "id": "dark-body-text-on-page",
      "foregroundToken": "color.dark.foreground",
      "backgroundToken": "color.dark.background",
      "usage": "normalText"
    },
    {
      "id": "dark-body-text-on-card",
      "foregroundToken": "color.dark.foreground",
      "backgroundToken": "color.dark.card",
      "usage": "normalText"
    },
    {
      "id": "dark-muted-text-on-page",
      "foregroundToken": "color.dark.muted",
      "backgroundToken": "color.dark.background",
      "usage": "normalText"
    },
    {
      "id": "dark-muted-text-on-card",
      "foregroundToken": "color.dark.muted",
      "backgroundToken": "color.dark.card",
      "usage": "normalText"
    },
    {
      "id": "dark-subtle-text-on-page",
      "foregroundToken": "color.dark.mutedForeground",
      "backgroundToken": "color.dark.background",
      "usage": "normalText"
    },
    {
      "id": "dark-subtle-text-on-card",
      "foregroundToken": "color.dark.mutedForeground",
      "backgroundToken": "color.dark.card",
      "usage": "normalText"
    },
    {
      "id": "dark-primary-text-on-page",
      "foregroundToken": "color.dark.primary",
      "backgroundToken": "color.dark.background",
      "usage": "normalText"
    },
    {
      "id": "dark-primary-text-on-card",
      "foregroundToken": "color.dark.primary",
