  "categories": {
    "color": {
      "description": "Color palette tokens for light and dark modes",
      "type": "color",
      "darkPrefix": "color.dark",
      "tokens": {
        "color.primary": {
          "description": "THE brand token. The single key a tenant sets to change the colour their form renders in; the default skin fans it out to the focus ring, section headings and the primary button. There is no color.accent — see token-registry-spec §2.4.",
          "default": "#27594f",
          "dark": "#8bb8ac"
        },
        "color.primaryForeground": {
          "description": "Text color on primary backgrounds",
          "default": "#ffffff",
          "dark": "#ffffff"
        },
        "color.foreground": {
          "description": "Default text color",
          "default": "#20241f",
          "dark": "#f3ecdf"
        },
        "color.background": {
          "description": "Page/form background color",
          "default": "#f6f0e6",
          "dark": "#161311"
        },
        "color.border": {
          "description": "Default border color",
          "default": "#d1c8ba",
          "dark": "#4f463d"
        },
        "color.card": {
          "description": "Card/panel surface color",
          "default": "#fdfaf4",
          "dark": "#211c19"
        },
        "color.muted": {
          "description": "Muted text color",
          "default": "#686158",
          "dark": "#c4b8a7"
        },
        "color.mutedForeground": {
          "description": "Subtle text color",
          "default": "#736c62",
          "dark": "#ad9f8d"
        },
        "color.error": {
          "description": "Error/danger indicator color",
          "default": "#c1281f",
          "dark": "#ff8b7f"
        },
        "color.warning": {
          "description": "Warning/caution indicator color",
          "default": "#946112",
          "dark": "#e2b35c"
        },
        "color.success": {
          "description": "Success/confirmation indicator color",
          "default": "#2f855a",
          "dark": "#79c89d"
        },
        "color.info": {
          "description": "Informational indicator color",
          "default": "#2b6cb0",
          "dark": "#82b8f8"
        },
        "color.ring": {
          "description": "Focus ring color. Derived from color.primary when a theme leaves it unset; set it explicitly only to break that link.",
          "derivedFrom": "color.primary",
          "default": "#27594f",
          "dark": "#8fc6b7"
        },
        "color.input": {
          "description": "Input border color. Defaults maintain at least 3:1 contrast against the matching card surface.",
          "default": "#8b8175",
          "dark": "#7b6f61"
        },
        "color.surface": {
          "description": "Muted surface/panel background",
          "default": "#f2ece2",
          "dark": "#2a241f"
        }
      }
    },
    "spacing": {
      "description": "Layout spacing scale",
      "type": "dimension",
      "tokens": {
        "spacing.xs": {
          "description": "Extra-small spacing",
          "default": "0.25rem"
        },
        "spacing.sm": {
          "description": "Small spacing",
          "default": "0.5rem"
        },
        "spacing.md": {
          "description": "Medium spacing, used for container and grid gaps",
          "default": "1rem"
        },
        "spacing.lg": {
          "description": "Large spacing",
          "default": "1.5rem"
        },
        "spacing.xl": {
          "description": "Extra-large spacing",
          "default": "2rem"
        },
        "spacing.field": {
          "description": "Vertical gap between form fields",
          "default": "0.75rem",
          "adapterDefault": true
        },
        "spacing.section": {
          "description": "Vertical gap above a section: a group titled at section depth",
          "default": "1.5rem",
          "adapterDefault": true
        }
      }
    },
    "radius": {
      "description": "Border radius scale",
      "type": "dimension",
      "tokens": {
        "radius.sm": {
          "description": "Small border radius for inputs and controls",
          "default": "0.9rem"
        },
        "radius.md": {
          "description": "Medium border radius for cards and panels",
          "default": "1.35rem"
        }
      }
    },
    "font": {
      "description": "Typography tokens",
      "type": "fontFamily",
      "tokens": {
        "font.family": {
          "description": "Base font family stack",
          "default": "\"Instrument Sans\", \"Avenir Next\", \"Segoe UI\", sans-serif"
        },
        "font.weight.regular": {
          "type": "fontWeight",
          "description": "Standard text weight",
          "default": 400
        },
        "font.weight.medium": {
          "type": "fontWeight",
          "description": "Emphasized text weight",
          "default": 500
        },
        "font.weight.bold": {
          "type": "fontWeight",
          "description": "Heading / strong emphasis weight",
          "default": 700
        },
        "font.lineHeight.tight": {
          "type": "number",
          "description": "Tight line height for headings",
          "default": 1.25
        },
        "font.lineHeight.normal": {
          "type": "number",
          "description": "Standard body line height",
          "default": 1.5
        },
        "font.lineHeight.loose": {
          "type": "number",
          "description": "Loose line height for long-form reading",
          "default": 1.75
        }
      }
    }
  }
}
