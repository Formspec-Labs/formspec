{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formspec.org/schemas/surface-scenario/0.1",
  "title": "Formspec Surface Preview Scenario",
  "description": "Preview-only runtime state for exercising a data-only Surface bundle. This document is not an App Manifest member and MUST NOT be treated as production data. It supplies route parameters, qualified Data Source outcomes, coarse authorization verdicts, and simulated action outcomes to a fixed generic preview host.",
  "type": "object",
  "required": [
    "$formspecSurfaceScenario",
    "version",
    "initialPath",
    "defaultProfile",
    "profiles",
    "actions"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "routeParamsGeneration": ["routeParams"]
  },
  "properties": {
    "$formspecSurfaceScenario": {
      "const": "0.1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "initialPath": {
      "type": "string",
      "pattern": "^/"
    },
    "routeParams": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "x-generation": {
      "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
      "description": "Direct generation provenance for the scenario's initialPath and defaultProfile choices. Strict data-only preview validation treats the scenario root as one semantic node and requires its own current adopted Need anchor."
    },
    "routeParamsGeneration": {
      "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
      "description": "Direct generation provenance for routeParams as one structured semantic node. The anchor applies to the route-parameter setup as a whole, not to individual keys or values, and never inherits from the scenario root."
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/SurfaceScenarioProfile"
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "$ref": "#/$defs/SurfaceScenarioActionOutcomes"
    }
  },
  "$defs": {
    "SurfaceScenarioCatalogRef": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+"
    },
    "SurfaceScenarioSourceRef": {
      "type": "string",
      "pattern": "^(host|response|resource|query|conversation|route):[a-z][a-z0-9]*(?:-[a-z][a-z0-9]*)*$"
    },
    "SurfaceScenarioAuthorizationOverride": {
      "type": "object",
      "required": [
        "catalogRef",
        "sourceRef",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogRef": {
          "$ref": "#/$defs/SurfaceScenarioCatalogRef"
        },
        "sourceRef": {
          "$ref": "#/$defs/SurfaceScenarioSourceRef"
        },
        "decision": {
          "enum": [
            "authorized",
            "refused"
          ]
        }
      }
    },
    "SurfaceScenarioAuthorization": {
      "type": "object",
      "required": [
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "authorized",
            "refused"
          ]
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurfaceScenarioAuthorizationOverride"
          }
        }
      }
    },
    "SurfaceScenarioLoadedSource": {
      "type": "object",
      "required": [
        "catalogRef",
        "sourceRef",
        "status",
        "freshness",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogRef": {
          "$ref": "#/$defs/SurfaceScenarioCatalogRef"
        },
        "sourceRef": {
          "$ref": "#/$defs/SurfaceScenarioSourceRef"
        },
        "status": {
          "const": "loaded"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale"
          ]
        },
        "x-generation": {
          "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
          "description": "Direct generation provenance for this qualified source outcome as one semantic unit. Strict data-only preview validation requires the outcome's own current adopted Need anchor and does not inspect rows, cells, or nested value members as separate nodes."
        },
        "value": true
      }
    },
    "SurfaceScenarioUnavailableSource": {
      "type": "object",
      "required": [
        "catalogRef",
        "sourceRef",
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogRef": {
          "$ref": "#/$defs/SurfaceScenarioCatalogRef"
        },
        "sourceRef": {
          "$ref": "#/$defs/SurfaceScenarioSourceRef"
        },
        "status": {
          "const": "unavailable"
        },
        "x-generation": {
          "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
          "description": "Direct generation provenance for this qualified source outcome as one semantic unit. Strict data-only preview validation requires the outcome's own current adopted Need anchor and does not inherit one from the profile or scenario root."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SurfaceScenarioErrorSource": {
      "type": "object",
      "required": [
        "catalogRef",
        "sourceRef",
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogRef": {
          "$ref": "#/$defs/SurfaceScenarioCatalogRef"
        },
        "sourceRef": {
          "$ref": "#/$defs/SurfaceScenarioSourceRef"
        },
        "status": {
          "const": "error"
        },
        "x-generation": {
          "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
          "description": "Direct generation provenance for this qualified simulated loader failure. Strict data-only preview validation requires the outcome's own current adopted Need anchor."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Technical preview-only failure detail retained for diagnostics and never rendered as customer copy."
        }
      }
    },
    "SurfaceScenarioSourceOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/SurfaceScenarioLoadedSource"
        },
        {
          "$ref": "#/$defs/SurfaceScenarioUnavailableSource"
        },
        {
          "$ref": "#/$defs/SurfaceScenarioErrorSource"
        }
      ]
    },
    "SurfaceScenarioProfile": {
      "type": "object",
      "required": [
        "authorization",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/SurfaceScenarioAuthorization"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurfaceScenarioSourceOutcome"
          }
        },
        "filings": {
          "type": "array",
          "description": "Optional sample completed Responses admitted into the preview filing store for this profile.",
          "items": {
            "$ref": "#/$defs/SurfaceScenarioFiling"
          }
        },
        "decisions": {
          "type": "array",
          "description": "Optional review dispositions joined to sample completed Responses by exact (responseId, responseHash).",
          "items": {
            "$ref": "#/$defs/SurfaceScenarioDecision"
          }
        },
        "drafts": {
          "type": "array",
          "description": "Optional preview-only in-progress drafts seeded into the preview DraftPort for this profile alongside completed filings and decisions.",
          "items": {
            "$ref": "#/$defs/SurfaceScenarioDraft"
          }
        }
      }
    },
    "SurfaceScenarioDraftSubject": {
      "type": "object",
      "description": "Typed subject identity for a seeded in-progress draft. Must match the target Definition's declared subject type and keys. The preview store derives the canonical subject id hash from (type, keys) at admission.",
      "required": [
        "type",
        "keys"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "https://example.test/definitions/annual-report",
          "keys": {
            "year": 2026,
            "unit": "north"
          }
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s{}]+$",
          "description": "Canonical URI of the filing-unit subject type matching the target FormDefinition's subject.type.",
          "examples": [
            "https://example.test/definitions/annual-report"
          ]
        },
        "keys": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "description": "Exact subject key values matching the target FormDefinition's subject.keys declaration (strings or I-JSON safe integers).",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ]
          },
          "examples": [
            {
              "year": 2026,
              "unit": "north"
            }
          ]
        }
      }
    },
    "SurfaceScenarioDraft": {
      "type": "object",
      "description": "Preview-only in-progress draft seeded into the preview DraftPort. Supplies initial draft answers for one FormDefinition (and optional subject) so filing-status trackers show In Progress or Ready status and opening the form hydrates the saved answers.",
      "required": [
        "definitionUrl",
        "data"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "definitionUrl": "https://example.test/definitions/annual-report",
          "subject": {
            "type": "https://example.test/definitions/annual-report",
            "keys": {
              "year": 2026,
              "unit": "north"
            }
          },
          "data": {
            "summary": "Initial draft notes"
          }
        },
        {
          "definitionUrl": "https://example.test/definitions/intake",
          "definitionVersion": "1.0.0",
          "responseId": "urn:uuid:11111111-2222-4333-8444-555555555555",
          "authored": "2026-01-15T12:00:00Z",
          "data": {
            "applicantName": "Alex Rivera"
          }
        }
      ],
      "properties": {
        "x-generation": {
          "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
          "description": "Direct generation provenance for this seeded preview draft fixture."
        },
        "definitionUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+",
          "description": "Canonical URL of the target FormDefinition in the resolved bundle.",
          "examples": [
            "https://example.test/definitions/annual-report"
          ]
        },
        "definitionVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Definition version pin. When omitted, defaults to the resolved bundle Definition's version; when supplied, it must match that Definition's version.",
          "examples": [
            "1.0.0"
          ]
        },
        "subject": {
          "$ref": "#/$defs/SurfaceScenarioDraftSubject",
          "description": "Typed subject key for a subject-keyed FormDefinition. Required when the Definition declares subject; must be omitted when the Definition declares no subject."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Partial or complete in-progress answer payload keyed by Definition item keys, hydrated into the form engine draft snapshot and in-progress Response.",
          "examples": [
            {
              "summary": "Initial draft notes",
              "count": 42
            }
          ]
        },
        "responseId": {
          "type": "string",
          "minLength": 1,
          "description": "Optional stable Response ID for the seeded draft. Must be unique across all drafts and filings in the same profile.",
          "examples": [
            "urn:uuid:11111111-2222-4333-8444-555555555555"
          ]
        },
        "authored": {
          "type": "string",
          "format": "date-time",
          "description": "Optional RFC 3339 timestamp recorded as the in-progress Response's authored timestamp.",
          "examples": [
            "2026-01-15T12:00:00Z"
          ]
        }
      }
    },
    "SurfaceScenarioFiling": {
      "type": "object",
      "required": [
        "responseJson"
      ],
      "additionalProperties": false,
      "properties": {
        "x-generation": {
          "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation"
        },
        "responseJson": {
          "type": "string",
          "minLength": 1,
          "description": "Exact JSON text of a sample completed Response. Subject identity and handoff hash are checked at admission."
        }
      }
    },
    "SurfaceScenarioDecision": {
      "type": "object",
      "required": [
        "responseId",
        "responseHash",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "responseId": {
          "type": "string",
          "minLength": 1
        },
        "responseHash": {
          "$ref": "https://formspec.org/schemas/response/1.0#/$defs/Sha256Digest"
        },
        "decision": {
          "$ref": "https://formspec.org/schemas/response-selection/1.0#/$defs/DispositionObservation"
        }
      }
    },
    "SurfaceScenarioActionOutcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "fail",
            "defer"
          ]
        },
        "message": {
          "type": "string"
        },
        "x-generation": {
          "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Generation",
          "description": "Direct generation provenance for this simulated action outcome. Strict data-only preview validation requires each default or action-specific outcome to carry its own current adopted Need anchor."
        }
      }
    },
    "SurfaceScenarioActionOutcomes": {
      "type": "object",
      "required": [
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/SurfaceScenarioActionOutcome"
        },
        "byAction": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9-]*$": {
              "$ref": "#/$defs/SurfaceScenarioActionOutcome"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
