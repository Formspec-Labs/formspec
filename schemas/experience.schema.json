{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formspec.org/schemas/experience/1.0",
  "title": "Formspec Experience",
  "description": "A Formspec Experience Document per the Experience specification. A standalone sidecar that names abstract task intent for a Formspec Definition: actors, tasks, units, applicability, and typed references to items, concepts, and actions. Like Theme, Component, Locale, and References documents, an Experience Document targets a Definition but lives alongside it. Multiple Experience Documents MAY target the same Definition (e.g., different actor populations, platforms, or postures). Experience metadata MUST NOT alter core behavioral semantics (required, relevant, readonly, calculate, validation).",
  "type": "object",
  "required": ["$formspecExperience", "version", "targetDefinition"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "$formspecExperience": {
      "type": "string",
      "const": "1.0",
      "description": "Experience specification version. MUST be '1.0'.",
      "examples": ["1.0"],
      "x-lm": {
        "critical": true,
        "intent": "Version pin for experience document compatibility"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of this Experience Document. SemVer is RECOMMENDED.",
      "examples": ["1.0.0"],
      "x-lm": {
        "critical": true,
        "intent": "Experience document revision identifier"
      }
    },
    "targetDefinition": {
      "$ref": "#/$defs/TargetDefinition",
      "description": "Binding to the target Definition document. Same shape as Theme / Component / Locale.",
      "examples": [
        { "url": "https://example.gov/forms/intake", "compatibleVersions": ">=1.0.0 <2.0.0" }
      ],
      "x-lm": {
        "critical": true,
        "intent": "Target Definition URL and compatible-versions range"
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_\\-]*$"
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "applicability": { "$ref": "#/$defs/Applicability" },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/Actor" },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/Task" },
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "description": "Substantive Experience payload. Each Unit organizes typed item, concept, and action references under abstract task intent.",
      "items": { "$ref": "#/$defs/Unit" },
      "examples": [
        [
          {
            "id": "identity",
            "kind": "data-entry",
            "itemRefs": [{ "path": "applicantName" }]
          }
        ]
      ],
      "x-lm": {
        "critical": true,
        "intent": "Substantive payload; units organize typed references under tasks"
      }
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "$defs": {
    "TargetDefinition": {
      "$ref": "https://formspec.org/schemas/common/1.0#/$defs/TargetDefinition"
    },
    "Extensions": {
      "$ref": "https://formspec.org/schemas/common/1.0#/$defs/Extensions"
    },
    "Actor": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Stable identifier for this Actor. Unique within actors[].",
          "examples": ["applicant", "reviewer"]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Stable identifier for this Task. Unique within tasks[]. Referenced by Component nodes via taskRefs[].",
          "examples": ["identifyApplicant", "reviewEligibility"]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "actorRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Unit": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Stable identifier for this Unit. Unique within units[]. Referenced by Component nodes via unitRef.",
          "examples": ["identity", "householdReview", "submitConfirmation"]
        },
        "kind": {
          "$ref": "#/$defs/UnitKind"
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "actorRef": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Actor this unit is intended for. MUST resolve to actors[].id."
        },
        "taskRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "description": "Tasks this unit advances. Each MUST resolve to tasks[].id."
        },
        "itemRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ItemRef" }
        },
        "conceptRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConceptRef" }
        },
        "actionRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActionRef" }
        },
        "applicability": { "$ref": "#/$defs/Applicability" },
        "accessibility": { "$ref": "#/$defs/Accessibility" },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "UnitKind": {
      "type": "string",
      "enum": [
        "data-entry",
        "review",
        "confirmation",
        "evidence-collection",
        "attestation",
        "error-resolution",
        "assistance"
      ],
      "description": "Closed, abstract, task-oriented unit kind. data-entry: user provides or revises data. review: read-only display of captured data. confirmation: user affirms accuracy before a transition. evidence-collection: user supplies evidence (attachments, attestations). attestation: user certifies a statement under accountability. error-resolution: user resolves a validation finding. assistance: user receives help.",
      "examples": ["data-entry", "review", "confirmation"],
      "x-lm": {
        "critical": true,
        "intent": "Closed task-oriented enum; closure prevents layout-container drift"
      }
    },
    "ItemRef": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Definition item path using Core FieldRef syntax. For repeat-group children use the [*] wildcard path (e.g., household.members[*].firstName).",
          "examples": ["applicantName", "household.members[*].firstName"]
        },
        "purpose": {
          "type": "string",
          "enum": ["collect", "display", "attest", "cite"],
          "description": "User-facing purpose. Default depends on enclosing unit.kind (S6.1)."
        },
        "description": { "type": "string" },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "ConceptRef": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Registry / Ontology concept identifier."
        },
        "source": {
          "type": "string",
          "enum": ["registry", "ontology", "external"],
          "default": "registry"
        },
        "description": { "type": "string" },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "ActionRef": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Response Action identifier. MUST resolve against the loaded Response Actions document's actions[*].id set."
        },
        "role": {
          "type": "string",
          "enum": ["primary", "secondary", "escape"],
          "default": "primary"
        },
        "description": { "type": "string" },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Open enum. Common values: web, mobile, pdf, cli, voice, agent."
        },
        "locales": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[A-Za-z0-9]+)*$" },
          "description": "BCP 47 locale tags."
        },
        "posture": { "type": "string" },
        "channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistive": { "type": "boolean", "default": true },
        "complexity": { "type": "string", "enum": ["low", "moderate", "high"] },
        "requiresLiteracy": { "type": "boolean" },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    }
  }
}
