{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formspec.org/spikes/wireframe-generator-v2/surface/0.1",
  "title": "Spike v2 Surface",
  "description": "Spike-local Surface schema that models the ADR 0150 route graph and closed slot-type taxonomy until an official Surface schema lands.",
  "type": "object",
  "required": ["$formspecSurface", "url", "version", "appName", "targetExperience", "routes"],
  "additionalProperties": false,
  "properties": {
    "$formspecSurface": { "const": "0.1-spike-v2" },
    "url": { "type": "string", "format": "uri" },
    "version": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleRef" }
    },
    "description": { "type": "string" },
    "appName": { "type": "string", "minLength": 1 },
    "appTagline": { "type": "string" },
    "targetExperience": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "compatibleVersions": { "type": "string", "minLength": 1 }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "path"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Route" }
    }
  },
  "$defs": {
    "ModuleRef": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^x-[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
        },
        "version": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "format": "uri" },
        "lockHash": { "type": "string" }
      }
    },
    "Route": {
      "type": "object",
      "required": ["id", "path", "slots"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "path": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "default": { "type": "boolean" },
        "layout": { "enum": ["shell-with-main", "shell-with-three-pane"] },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "example": { "type": "string" }
            }
          }
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/SlotEntry" }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on", "to"],
            "additionalProperties": false,
            "properties": {
              "on": { "type": "string" },
              "to": { "type": "string" },
              "params": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "SlotEntry": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["definition-form", "experience-unit", "module-widget", "static-content", "embed-route"]
        },
        "title": { "type": "string" },
        "definitionRef": { "type": "string" },
        "unitRef": { "type": "string" },
        "widgetRef": {
          "type": "string",
          "pattern": "^x-[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
        },
        "routeRef": { "type": "string" },
        "module": { "$ref": "#/$defs/ModuleRef" },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "definition-form" } }, "required": ["type"] },
          "then": { "required": ["definitionRef", "unitRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "experience-unit" } }, "required": ["type"] },
          "then": { "required": ["unitRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "module-widget" } }, "required": ["type"] },
          "then": { "required": ["widgetRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "embed-route" } }, "required": ["type"] },
          "then": { "required": ["routeRef"] }
        }
      ]
    }
  }
}

