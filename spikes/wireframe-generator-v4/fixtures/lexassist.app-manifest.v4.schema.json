{
  "$id": "https://formspec.org/spikes/wireframe-generator-v4/app-manifest/0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spike v4 App Manifest Prototype",
  "description": "Spike-local prototype schema for first-class app sidecar indexes. Not a Formspec conformance schema.",
  "type": "object",
  "required": [
    "$formspecBundle",
    "version",
    "id",
    "definitions",
    "experiences",
    "responseActions",
    "registries",
    "surfaces",
    "dataSources",
    "uiPolicy",
    "posture",
    "screeners",
    "runtimePlan",
    "modules"
  ],
  "properties": {
    "$formspecBundle": { "const": "2.0" },
    "version": { "type": "string" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/LocalRef" }
    },
    "experiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/LocalRef" },
          {
            "type": "object",
            "required": ["targetDefinitions"],
            "properties": {
              "targetDefinitions": {
                "type": "array",
                "items": { "$ref": "#/$defs/TargetDefinitionRef" }
              }
            }
          }
        ]
      }
    },
    "responseActions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/LocalRef" },
          {
            "type": "object",
            "required": ["targetDefinition"],
            "properties": {
              "targetDefinition": { "$ref": "#/$defs/TargetDefinitionRef" }
            }
          }
        ]
      }
    },
    "registries": {
      "type": "array",
      "items": { "$ref": "#/$defs/LocalRef" }
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/LocalRef" }
    },
    "dataSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/LocalRef" }
    },
    "uiPolicy": { "$ref": "#/$defs/LocalRef" },
    "posture": { "$ref": "#/$defs/LocalRef" },
    "screeners": {
      "type": "array",
      "items": { "$ref": "#/$defs/LocalRef" }
    },
    "runtimePlan": { "$ref": "#/$defs/LocalRef" },
    "modules": {
      "type": "array",
      "items": { "$ref": "https://formspec.org/schemas/common/1.0#/$defs/ModuleRef" }
    },
    "sessions": {
      "type": "array",
      "items": { "$ref": "https://formspec.org/schemas/common/1.0#/$defs/SessionRef" }
    },
    "locales": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/LocalRef" },
          {
            "type": "object",
            "required": ["locale"],
            "properties": { "locale": { "type": "string" } }
          }
        ]
      }
    },
    "v4PrototypeNotes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LocalRef": {
      "type": "object",
      "required": ["url", "fixture"],
      "propertyNames": {
        "not": {
          "pattern": "^x-spike-v3-"
        }
      },
      "properties": {
        "url": { "type": "string" },
        "version": { "type": "string" },
        "fixture": { "type": "string", "pattern": "^[^/].*" }
      },
      "additionalProperties": true
    },
    "TargetDefinitionRef": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "compatibleVersions": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
