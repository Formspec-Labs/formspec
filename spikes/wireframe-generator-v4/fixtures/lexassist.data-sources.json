      "schema": { "type": "object" }
    },
    {
      "id": "conversation:demand-response-thread",
      "kind": "conversation-stream",
      "routeRef": "thread",
      "owner": "module",
      "scope": "route",
      "runtime": {
        "delivery": "live",
        "cache": { "mode": "subscribe", "staleAfter": "PT30S" },
        "authorizationBoundary": "module",
        "failureMode": "degraded-widget",
        "provenance": { "kind": "conversation-stream", "source": "threadTranscript" }
      },
      "schema": { "type": "array", "items": { "type": "object" } }
