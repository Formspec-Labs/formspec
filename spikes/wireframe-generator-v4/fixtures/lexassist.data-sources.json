    {
      "id": "host:open-matters",
      "kind": "host-state",
      "owner": "host",
      "scope": "session",
      "runtime": {
        "delivery": "live",
        "cache": { "mode": "subscribe", "staleAfter": "PT5M" },
        "authorizationBoundary": "host",
        "failureMode": "empty-state",
        "provenance": { "kind": "host-state", "source": "openMatterStore" }
      },
      "schema": { "type": "array", "items": { "type": "object" } }
    },
    {
      "id": "host:matter-threads",
      "kind": "host-state",
      "owner": "host",
      "scope": "route",
      "routeRef": "matter",
      "runtime": {
        "delivery": "live",
        "cache": { "mode": "subscribe", "staleAfter": "PT2M" },
        "authorizationBoundary": "host",
        "failureMode": "empty-state",
        "provenance": { "kind": "host-state", "source": "matterThreadStore" }
      },
      "schema": { "type": "array", "items": { "type": "object" } }
    },
    {
      "id": "host:matter-activity",
      "kind": "host-state",
      "owner": "host",
      "scope": "route",
      "routeRef": "matter",
      "runtime": {
        "delivery": "live",
        "cache": { "mode": "subscribe", "staleAfter": "PT1M" },
        "authorizationBoundary": "host",
        "failureMode": "degraded-widget",
        "provenance": { "kind": "host-state", "source": "matterActivityStore" }
      },
      "schema": { "type": "array", "items": { "type": "object" } }
    },
    {
