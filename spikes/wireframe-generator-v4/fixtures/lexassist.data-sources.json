      "kind": "host-state",
      "owner": "host",
      "scope": "route",
      "routeRef": "matter",
      "runtime": {
        "delivery": "snapshot",
        "cache": { "mode": "snapshot", "staleAfter": "PT10M" },
        "authorizationBoundary": "host",
        "failureMode": "stale-ok",
        "provenance": { "kind": "host-state", "source": "matterStore" }
      },
      "schema": { "type": "object" }
    },
    {
      "id": "host:route-params",
      "kind": "route-params",
      "owner": "formspec",
      "scope": "route",
      "runtime": {
        "delivery": "snapshot",
