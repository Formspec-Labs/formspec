      "schema": { "type": "array", "items": { "type": "object" } }
    },
    {
      "id": "response:new-matter",
      "kind": "definition-response",
      "definitionRef": "new-matter",
      "owner": "formspec",
      "scope": "definition",
      "runtime": {
        "delivery": "draft",
        "cache": { "mode": "draft" },
        "authorizationBoundary": "formspec-session",
        "failureMode": "empty-state",
        "provenance": { "kind": "definition-response", "source": "new-matter" }
      },
      "schema": { "type": "object" }
    },
    {
      "id": "response:playbook-runner",
      "kind": "definition-response",
      "definitionRef": "playbook-runner",
      "owner": "formspec",
      "scope": "definition",
      "runtime": {
        "delivery": "draft",
        "cache": { "mode": "draft" },
        "authorizationBoundary": "formspec-session",
