      "schema": { "type": "object" }
    },
    {
      "id": "resource:library-index",
      "kind": "document-resource",
      "routeRef": "library",
      "owner": "host",
      "scope": "resource",
      "runtime": {
        "delivery": "snapshot",
        "cache": { "mode": "snapshot", "staleAfter": "PT15M" },
        "authorizationBoundary": "host",
        "failureMode": "stale-ok",
        "provenance": { "kind": "document-resource", "source": "libraryIndex" }
      },
      "schema": { "type": "object" }
    },
    {
      "id": "query:library-search",
      "kind": "query-result",
      "routeRef": "library",
      "owner": "host",
      "scope": "session",
      "runtime": {
        "delivery": "snapshot",
        "cache": { "mode": "snapshot", "staleAfter": "PT5M" },
        "authorizationBoundary": "host",
        "failureMode": "empty-state",
        "provenance": { "kind": "query-result", "source": "librarySearchIndex" }
      },
      "schema": { "type": "array", "items": { "type": "object" } }
    }
  ]
}
