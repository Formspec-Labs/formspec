    {
      "name": "x-formspec-core-component",
      "category": "module",
      "version": "1.0.0",
      "status": "stable",
      "description": "Core Component widget catalog and generated Component identity semantics.",
      "compatibility": { "formspecVersion": ">=1.0.0 <2.0.0" },
      "contributes": []
    },
    {
      "name": "x-formspec-surface",
      "category": "module",
      "version": "0.1.0",
      "status": "stable",
      "description": "ADR-0150 Surface route graph and slot composition module.",
      "compatibility": { "formspecVersion": ">=1.0.0 <2.0.0" },
      "dependencies": [
        { "id": "x-formspec-core-task", "version": "^1.0.0" },
        { "id": "x-formspec-core-actions", "version": "^1.0.0" }
      ],
      "contributes": [
        "x-formspec-slot-definition-form",
        "x-formspec-slot-experience-unit",
        "x-formspec-slot-module-widget",
