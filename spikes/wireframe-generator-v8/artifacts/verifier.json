{
  "mockup": "surfaces/verifier.html",
  "family": "interactive-tool",
  "route": "/verify",
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/trust/verifier",
    "title": "Verifier",
    "definitions": [],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/trust/verifier/surfaces/verify",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-artifact-input",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-verification-result",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-computation-log",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "verify",
    "entry": "verify",
    "routes": [
      {
        "id": "verify",
        "path": "/verify",
        "title": "Verify a Receipt",
        "slots": [
          {
            "id": "assurance",
            "slotType": "static-content",
            "binding": {
              "kind": "text",
              "content": "Runs entirely in this tab — no data leaves your browser. The verifier recomputes the response hash, checks the signature chain, and confirms the Trellis anchor locally, without contacting Formspec Cloud."
            },
            "title": "Verify a Receipt"
          },
          {
            "id": "receiptInput",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-artifact-input",
              "widgetName": "ReceiptInput",
              "config": {
                "accepts": [
                  "application/json",
                  ".receipt.json"
                ],
                "schema": "https://formspec.org/schemas/receipt/1.0",
                "persist": false,
                "publishes": "x-spike-v8:channel:receipt-bytes"
              }
            },
            "title": "Receipt input"
          },
          {
            "id": "verifyAction",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-verification-result",
              "widgetName": "VerifyButton",
              "config": {
                "consumes": "x-spike-v8:channel:receipt-bytes",
                "executor": "x-spike-v8:client-only",
                "emits": "x-spike-v8:channel:verification-result"
              }
            },
            "title": "Verify locally"
          },
          {
            "id": "result",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-verification-result",
              "widgetName": "VerificationResult",
              "config": {
                "consumes": "x-spike-v8:channel:verification-result",
                "checks": [
                  "response-hash",
                  "definition-pin",
                  "signature-chain",
                  "anchor-present",
                  "inclusion-proof",
                  "schema-conformance"
                ]
              }
            },
            "title": "Verification result"
          },
          {
            "id": "computationLog",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-computation-log",
              "widgetName": "ComputationLog",
              "config": {
                "consumes": "x-spike-v8:channel:verification-result",
                "streaming": true
              }
            },
            "title": "Computation log"
          }
        ]
      }
    ]
  },
  "uiGraphPolicy": {
    "$formspecUiGraphPolicy": "0.1",
    "version": "1.0.0",
    "title": "Verifier policy",
    "description": "Anonymous route. Tenant theming must never reach it — the verifier's independence from any tenant is the claim it exists to make. Not assertable in the current policy shape (finding 6).",
    "targetSurface": {
      "url": "https://formspec.cloud/apps/trust/verifier/surfaces/verify",
      "version": "1.0.0"
    },
    "routePolicies": [
      {
        "routeId": "verify",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      }
    ]
  },
  "slotMockupRegions": [
    {
      "slot": "assurance",
      "slotType": "static-content",
      "mockupRegion": "chrome assurance line + explainer"
    },
    {
      "slot": "receiptInput",
      "slotType": "module-widget",
      "mockupRegion": "paste/upload receipt box with size, type, schema-validity readout"
    },
    {
      "slot": "verifyAction",
      "slotType": "module-widget",
      "mockupRegion": "\"Verify locally\" action — client-executed, no host call"
    },
    {
      "slot": "result",
      "slotType": "module-widget",
      "mockupRegion": "six-check result panel with per-check evidence and PASS badges"
    },
    {
      "slot": "computationLog",
      "slotType": "module-widget",
      "mockupRegion": "timestamped computation log streaming local operations"
    }
  ]
}