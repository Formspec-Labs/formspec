{
  "mockup": "surfaces/onboarding.html",
  "family": "wizard",
  "route": "/onboarding",
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/onboarding",
    "title": "Get started",
    "definitions": [],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/onboarding/surfaces/wizard",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-step-rail",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-tier-cards",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-region-picker",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-form-genesis",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "wizard",
    "entry": "organization",
    "routes": [
      {
        "id": "organization",
        "path": "/onboarding/organization",
        "title": "Tell us about your organization",
        "slots": [
          {
            "id": "stepRail",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-step-rail",
              "widgetName": "StepRail",
              "config": {
                "steps": [
                  "account",
                  "organization",
                  "tier",
                  "region",
                  "first-form",
                  "publish"
                ],
                "current": "organization",
                "estimate": "7 minutes"
              }
            },
            "title": "Steps"
          },
          {
            "id": "orgForm",
            "slotType": "definition-form",
            "binding": {
              "definitionRef": "https://formspec.cloud/definitions/onboarding-org",
              "version": "1.0.0"
            },
            "title": "Organization"
          }
        ]
      },
      {
        "id": "tier",
        "path": "/onboarding/tier",
        "title": "Pick a deployment tier",
        "slots": [
          {
            "id": "tierCards",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-tier-cards",
              "widgetName": "TierComparison",
              "config": {
                "dataSource": "x-spike-v8:catalog:deployment-tiers",
                "tiers": [
                  "shared",
                  "regulated",
                  "dedicated",
                  "air-gap"
                ],
                "recommended": "regulated"
              }
            },
            "title": "Deployment tier"
          }
        ]
      },
      {
        "id": "region",
        "path": "/onboarding/region",
        "title": "Where should your data live?",
        "slots": [
          {
            "id": "regionPicker",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-region-picker",
              "widgetName": "RegionPicker",
              "config": {
                "dataSource": "x-spike-v8:catalog:regions",
                "irreversibleAfter": "first-publish"
              }
            },
            "title": "Region"
          }
        ]
      },
      {
        "id": "first-form",
        "path": "/onboarding/first-form",
        "title": "Create your first form",
        "slots": [
          {
            "id": "genesis",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-form-genesis",
              "widgetName": "FormGenesis",
              "config": {
                "paths": [
                  "template",
                  "import",
                  "prompt-to-form",
                  "blank"
                ],
                "dataSource": "x-spike-v8:catalog:templates"
              }
            },
            "title": "First form"
          }
        ]
      }
    ]
  },
  "uiGraphPolicy": {
    "$formspecUiGraphPolicy": "0.1",
    "version": "1.0.0",
    "title": "Onboarding wizard policy",
    "targetSurface": {
      "url": "https://formspec.cloud/apps/console/onboarding/surfaces/wizard",
      "version": "1.0.0"
    },
    "routePolicies": [
      {
        "routeId": "organization",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      },
      {
        "routeId": "tier",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      },
      {
        "routeId": "region",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      },
      {
        "routeId": "first-form",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      }
    ]
  },
  "slotMockupRegions": [
    {
      "slot": "stepRail",
      "slotType": "module-widget",
      "mockupRegion": "step rail with completion ticks and estimated time"
    },
    {
      "slot": "orgForm",
      "slotType": "definition-form",
      "mockupRegion": "org name + workspace + work-type form (the native design fit)"
    },
    {
      "slot": "tierCards",
      "slotType": "module-widget",
      "mockupRegion": "four tier cards with price, claims, and a recommendation badge"
    },
    {
      "slot": "regionPicker",
      "slotType": "module-widget",
      "mockupRegion": "region picker with \"you cannot move data after publishing\" warning"
    },
    {
      "slot": "genesis",
      "slotType": "module-widget",
      "mockupRegion": "template / import / prompt-to-form / blank chooser plus template gallery"
    }
  ]
}