{
  "mockup": "surfaces/trust-center.html",
  "family": "content-compliance",
  "route": "/trust",
  "registryArm": "host-authored",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/trust/center/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "trust",
      "wanted": "attestation",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/trust/center",
    "title": "Trust Center",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/trust/center/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/trust/center/surfaces/trust",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-public-nav",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-profile-cards",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-capability-matrix",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "trust",
    "routes": [
      {
        "id": "trust",
        "path": "/trust",
        "slots": [
          {
            "id": "publicNav",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-public-nav",
              "widgetName": "PublicNav",
              "config": {
                "links": [
                  "deployments",
                  "data-handling",
                  "audits",
                  "contact"
                ]
              }
            },
            "position": "top",
            "title": "Trust"
          },
          {
            "id": "hero",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "Five deployment profiles. The proof surfaces are the same on every one.",
              "level": 1
            },
            "position": "main",
            "title": "Trust at Formspec Cloud"
          },
          {
            "id": "profileCards",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-profile-cards",
              "widgetName": "DeploymentProfiles",
              "config": {
                "dataSource": "x-spike-v9:catalog:deployment-profiles",
                "taxonomy": [
                  "shared",
                  "regulated",
                  "dedicated",
                  "self-hosted",
                  "air-gapped"
                ],
                "closed": true
              }
            },
            "position": "main",
            "title": "Deployment profiles"
          },
          {
            "id": "capabilityMatrix",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-capability-matrix",
              "widgetName": "CapabilityMatrix",
              "config": {
                "dataSource": "x-spike-v9:catalog:capability-claims",
                "rows": 14,
                "columns": [
                  "shared",
                  "regulated",
                  "dedicated",
                  "self-hosted",
                  "air-gapped"
                ],
                "cellTaxonomy": [
                  "yes",
                  "no",
                  "qualified",
                  "not-applicable"
                ]
              }
            },
            "position": "main",
            "title": "Capability matrix"
          },
          {
            "id": "freshness",
            "slotType": "static-content",
            "binding": {
              "kind": "text",
              "content": "Last updated 2026-05-15 · Updates follow our changelog policy."
            },
            "position": "bottom",
            "title": "Freshness"
          }
        ],
        "title": "Trust"
      }
    ],
    "entry": "trust"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
        "name": "x-cloud-public-nav",
        "category": "module",
        "version": "0.1.0",
        "status": "stable",
        "description": "Formspec Cloud product module x-cloud-public-nav.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "contributes": [
          "PublicNav"
        ]
      },
      {
        "name": "PublicNav",
        "category": "widget",
        "version": "0.1.0",
        "status": "stable",
        "description": "Widget PublicNav contributed by x-cloud-public-nav.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        }
      },
      {
        "name": "x-cloud-profile-cards",
        "category": "module",
        "version": "0.1.0",
        "status": "stable",
        "description": "Formspec Cloud product module x-cloud-profile-cards.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "contributes": [
          "DeploymentProfiles"
        ]
      },
      {
        "name": "DeploymentProfiles",
        "category": "widget",
        "version": "0.1.0",
        "status": "stable",
        "description": "Widget DeploymentProfiles contributed by x-cloud-profile-cards.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        }
      },
      {
        "name": "x-cloud-capability-matrix",
        "category": "module",
        "version": "0.1.0",
        "status": "stable",
        "description": "Formspec Cloud product module x-cloud-capability-matrix.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "contributes": [
          "CapabilityMatrix"
        ]
      },
      {
        "name": "CapabilityMatrix",
        "category": "widget",
        "version": "0.1.0",
        "status": "stable",
        "description": "Widget CapabilityMatrix contributed by x-cloud-capability-matrix.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        }
      }
    ]
  },
  "uiGraphPolicy": {
    "$formspecUiGraphPolicy": "0.1",
    "version": "1.0.0",
    "title": "Trust center policy",
    "targetSurface": {
      "url": "https://formspec.cloud/apps/trust/center/surfaces/trust",
      "version": "1.0.0"
    },
    "routePolicies": [
      {
        "routeId": "trust",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      }
    ],
    "theme": {
      "assignments": [
        {
          "widgetRef": {
            "moduleId": "x-cloud-capability-matrix",
            "widgetName": "CapabilityMatrix"
          },
          "slot": "accent",
          "token": "color.accent"
        },
        {
          "widgetRef": {
            "moduleId": "x-cloud-profile-cards",
            "widgetName": "DeploymentProfiles"
          },
          "slot": "surface",
          "token": "color.surface"
        }
      ]
    }
  },
  "slotMockupRegions": [
    {
      "slot": "publicNav",
      "slotType": "module-widget",
      "mockupRegion": "public nav (unauthenticated)"
    },
    {
      "slot": "hero",
      "slotType": "static-content",
      "mockupRegion": "positioning hero + explanatory paragraph"
    },
    {
      "slot": "profileCards",
      "slotType": "module-widget",
      "mockupRegion": "five profile cards, closed taxonomy (\"there is no Custom or Enterprise Plus\")"
    },
    {
      "slot": "capabilityMatrix",
      "slotType": "module-widget",
      "mockupRegion": "14x5 capability matrix — anchoring, BAA, FedRAMP, SOC 2, SSO, support-access mode"
    },
    {
      "slot": "freshness",
      "slotType": "static-content",
      "mockupRegion": "last-updated line + security policy / DPA / status / contact links"
    }
  ]
}