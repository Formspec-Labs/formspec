{
  "mockup": "surfaces/responses-index.html",
  "family": "collection-index",
  "route": "/forms/:id/responses",
  "registryArm": "materialised",
  "declareRegistry": {
    "ok": true,
    "url": "urn:formspec:doc:302537e324a30ed8:registry",
    "mintedBundleLocal": true
  },
  "routeClassOutcomes": [
    {
      "routeId": "responses",
      "wanted": "operation",
      "verbOk": true,
      "persisted": true
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/responses",
    "title": "Responses",
    "definitions": [],
    "registries": [
      {
        "url": "urn:formspec:doc:302537e324a30ed8:registry",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/responses/surfaces/responses",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-stat-tiles",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-filter-bar",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-response-table",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "responses",
    "routes": [
      {
        "id": "responses",
        "path": "/forms/:id/responses",
        "slots": [
          {
            "id": "proofStats",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-stat-tiles",
              "widgetName": "ProofStatStrip",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms/:id/response-metrics",
                "categories": [
                  "proof_ready",
                  "awaiting_signature",
                  "proof_pending",
                  "anchor_stalled"
                ]
              }
            },
            "position": "top",
            "title": "Responses"
          },
          {
            "id": "filters",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-filter-bar",
              "widgetName": "ResponseFilters",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms/:id/responses",
                "facets": [
                  "version",
                  "submitted",
                  "proof",
                  "signature"
                ],
                "publishes": "x-spike-v9:channel:response-query"
              }
            },
            "position": "top",
            "title": "Filters"
          },
          {
            "id": "viewControls",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-response-table",
              "widgetName": "ViewControls",
              "config": {
                "columns": [
                  "respondent",
                  "submitted",
                  "proof",
                  "signature",
                  "totalBudget",
                  "version",
                  "hash",
                  "ein",
                  "source",
                  "reviewer",
                  "timeOnForm"
                ],
                "viewState": "x-spike-v9:user-scoped:saved-views",
                "actions": [
                  "export"
                ]
              }
            },
            "position": "top",
            "title": "Columns & views"
          },
          {
            "id": "table",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-response-table",
              "widgetName": "ResponseTable",
              "config": {
                "consumes": "x-spike-v9:channel:response-query",
                "dataSource": "x-spike-v9:workspace:forms/:id/responses",
                "pagination": {
                  "pageSize": 12,
                  "total": 4218
                },
                "rowActions": [
                  "open-response",
                  "open-receipt"
                ]
              }
            },
            "position": "main",
            "title": "Responses"
          }
        ],
        "title": "Responses",
        "routeClass": "operation"
      }
    ],
    "entry": "responses"
  },
  "registryDocument": null,
  "uiGraphPolicy": {
    "$formspecUiGraphPolicy": "0.1",
    "version": "1.0.0",
    "title": "Responses index policy",
    "targetSurface": {
      "url": "https://formspec.cloud/apps/console/responses/surfaces/responses",
      "version": "1.0.0"
    },
    "routePolicies": [
      {
        "routeId": "responses",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      }
    ]
  },
  "slotMockupRegions": [
    {
      "slot": "proofStats",
      "slotType": "module-widget",
      "mockupRegion": "proof-state stat strip — 4 218 total split four ways with a refreshed-at stamp"
    },
    {
      "slot": "filters",
      "slotType": "module-widget",
      "mockupRegion": "filter chips with removal + add-filter"
    },
    {
      "slot": "viewControls",
      "slotType": "module-widget",
      "mockupRegion": "column configuration, saved views, export"
    },
    {
      "slot": "table",
      "slotType": "module-widget",
      "mockupRegion": "4 218-row table with proof state, signature progress, computed total, version, hash"
    }
  ]
}