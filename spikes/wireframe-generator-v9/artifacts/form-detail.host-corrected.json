{
  "mockup": "surfaces/form-detail.html",
  "family": "entity-detail",
  "route": "/forms/:id",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/console/form-detail/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "overview",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/form-detail",
    "title": "2026 Community Grant Application",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/console/form-detail/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/form-detail/surfaces/form",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-tab-nav",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-stat-tiles",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-version-lifecycle",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-share-panel",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "form",
    "routes": [
      {
        "id": "overview",
        "path": "/forms/:id",
        "slots": [
          {
            "id": "identityHeader",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "2026 Community Grant Application",
              "level": 1
            },
            "position": "top",
            "title": "Form"
          },
          {
            "id": "tabNav",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-tab-nav",
              "widgetName": "x-entity-tabs",
              "config": {
                "tabs": [
                  "overview",
                  "responses",
                  "versions",
                  "analytics",
                  "settings",
                  "share"
                ],
                "counts": {
                  "responses": 4218,
                  "versions": 3
                }
              }
            },
            "position": "top",
            "title": "Sections"
          },
          {
            "id": "kpiRow",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-stat-tiles",
              "widgetName": "x-kpi-tiles",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms/:id/metrics",
                "tiles": [
                  "responses-7d",
                  "completion-rate",
                  "avg-time",
                  "proof-p95"
                ]
              }
            },
            "position": "main",
            "title": "Metrics"
          },
          {
            "id": "versions",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-version-lifecycle",
              "widgetName": "x-version-list",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms/:id/versions",
                "lifecycle": [
                  "draft",
                  "active",
                  "retired"
                ],
                "rowActions": [
                  "diff",
                  "continue-editing"
                ]
              }
            },
            "position": "main",
            "title": "Versions"
          },
          {
            "id": "sharePanel",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-share-panel",
              "widgetName": "x-share-and-embed",
              "config": {
                "surfaces": [
                  "public-link",
                  "workflow-bound-link",
                  "embed-snippet"
                ],
                "workflowLinkTemplate": "https://forms.acme-coop.org/f/grants-2026?case={WOS_CASE_ID}"
              }
            },
            "position": "main",
            "title": "Share & embed"
          },
          {
            "id": "posture",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "Posture",
              "level": 2
            },
            "position": "right",
            "title": "Posture"
          }
        ],
        "title": "Overview"
      }
    ],
    "entry": "overview"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
