{
  "mockup": "surfaces/admin-billing.html",
  "family": "settings-admin",
  "route": "/admin/billing",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/console/admin-billing/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "billing",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/admin-billing",
    "title": "Billing",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/console/admin-billing/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/admin-billing/surfaces/billing",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-admin-nav",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-quota-meters",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-payment-method",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-invoice-table",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "billing",
    "routes": [
      {
        "id": "billing",
        "path": "/admin/billing",
        "slots": [
          {
            "id": "adminNav",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-admin-nav",
              "widgetName": "x-admin-section-nav",
              "config": {
                "sections": [
                  "members",
                  "billing",
                  "audit",
                  "retention",
                  "ai-policy",
                  "residency",
                  "sso",
                  "org"
                ],
                "counts": {
                  "members": 12
                }
              }
            },
            "position": "top",
            "title": "Admin"
          },
          {
            "id": "planPanel",
            "slotType": "experience-unit",
            "binding": {
              "unitRef": "currentPlanPanel"
            },
            "position": "main",
            "title": "Current plan"
          },
          {
            "id": "usageMeters",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-quota-meters",
              "widgetName": "x-quota-meters",
              "config": {
                "dataSource": "x-spike-v9:workspace:usage",
                "meters": [
                  "responses",
                  "signature-envelopes",
                  "api-requests",
                  "object-storage"
                ],
                "projection": true
              }
            },
            "position": "main",
            "title": "Usage"
          },
          {
            "id": "paymentMethod",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-payment-method",
              "widgetName": "x-payment-method",
              "config": {
                "externalHandoff": "x-spike-v9:external:payment-processor"
              }
            },
            "position": "right",
            "title": "Payment method"
          },
          {
            "id": "invoices",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-invoice-table",
              "widgetName": "x-invoice-table",
              "config": {
                "dataSource": "x-spike-v9:workspace:invoices",
                "columns": [
                  "invoice",
                  "period",
                  "amount",
                  "date",
                  "status"
                ],
                "rowActions": [
                  "download-pdf"
                ]
              }
            },
            "position": "main",
            "title": "Invoices"
          }
        ],
        "title": "Billing"
      }
    ],
    "entry": "billing"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
