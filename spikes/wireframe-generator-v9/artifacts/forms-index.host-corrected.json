{
  "mockup": "surfaces/forms-index v3.html",
  "family": "collection-index",
  "route": "/o/:org/w/:ws/forms",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/console/forms-index/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "index",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/forms-index",
    "title": "Forms",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/console/forms-index/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/forms-index/surfaces/forms",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-forms-collection",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-filter-bar",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-bulk-action-bar",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "forms",
    "routes": [
      {
        "id": "index",
        "path": "/o/:org/w/:ws/forms",
        "slots": [
          {
            "id": "headerStats",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "Forms",
              "level": 1
            },
            "position": "top",
            "title": "Forms"
          },
          {
            "id": "stateTabs",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-filter-bar",
              "widgetName": "x-state-tabs",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms",
                "facets": [
                  {
                    "id": "state",
                    "values": [
                      "all",
                      "live",
                      "paused",
                      "draft",
                      "closed",
                      "archived"
                    ]
                  }
                ]
              }
            },
            "position": "top",
            "title": "State"
          },
          {
            "id": "filterBar",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-filter-bar",
              "widgetName": "x-forms-filter-bar",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms",
                "facets": [
                  {
                    "id": "deployment",
                    "values": [
                      "shared",
                      "regulated",
                      "dedicated",
                      "air-gap"
                    ]
                  },
                  {
                    "id": "owner",
                    "source": "x-spike-v9:workspace:members"
                  },
                  {
                    "id": "program",
                    "source": "x-spike-v9:workspace:programs"
                  }
                ],
                "search": true,
                "groupBy": [
                  "program",
                  "recent-activity"
                ]
              }
            },
            "position": "top",
            "title": "Filters"
          },
          {
            "id": "bulkActions",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-bulk-action-bar",
              "widgetName": "x-bulk-action-bar",
              "config": {
                "actions": [
                  "pause",
                  "duplicate",
                  "move-to-program",
                  "add-tag",
                  "export",
                  "archive"
                ],
                "subject": "x-spike-v9:selection:forms"
              }
            },
            "position": "top",
            "title": "Bulk actions"
          },
          {
            "id": "formsList",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-forms-collection",
              "widgetName": "x-forms-collection",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms",
                "grouping": "program",
                "pinned": true,
                "columns": [
                  "title",
                  "state",
                  "window",
                  "owner",
                  "activeVersion",
                  "draftVersion",
                  "deployment",
                  "definitionId",
                  "tags",
                  "proofDistribution",
                  "completion",
                  "newDelta",
                  "lastActivity"
                ],
                "rowActions": [
                  "copy-link",
                  "preview",
                  "more"
                ],
                "emptyState": "x-spike-v9:state:no-forms"
              }
            },
            "position": "main",
            "title": "Forms"
          }
        ],
        "title": "Forms"
      }
    ],
    "entry": "index"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
        "name": "x-cloud-forms-collection",
