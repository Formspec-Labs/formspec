        ]
      },
      {
        "name": "x-response-table",
        "category": "widget",
        "version": "0.1.0",
        "status": "stable",
        "description": "Widget x-response-table contributed by x-cloud-response-table.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "widgetShape": {
          "tokenSlots": [
