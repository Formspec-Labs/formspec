        "description": "Widget x-view-controls contributed by x-cloud-response-table.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "widgetShape": {
          "tokenSlots": [
            {
              "name": "accent",
              "acceptedTokenCategories": [
                "color"
              ]
