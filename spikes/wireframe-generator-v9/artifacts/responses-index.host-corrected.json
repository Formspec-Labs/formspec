{
  "mockup": "surfaces/responses-index.html",
  "family": "collection-index",
  "route": "/forms/:id/responses",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/console/responses/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "responses",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/responses",
    "title": "Responses",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/console/responses/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/responses/surfaces/responses",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-stat-tiles",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-filter-bar",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-response-table",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "responses",
    "routes": [
      {
        "id": "responses",
        "path": "/forms/:id/responses",
        "slots": [
          {
            "id": "proofStats",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-stat-tiles",
              "widgetName": "x-proof-stat-strip",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms/:id/response-metrics",
                "categories": [
                  "proof_ready",
                  "awaiting_signature",
                  "proof_pending",
                  "anchor_stalled"
                ]
              }
            },
            "position": "top",
            "title": "Responses"
          },
          {
            "id": "filters",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-filter-bar",
              "widgetName": "x-response-filters",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms/:id/responses",
                "facets": [
                  "version",
                  "submitted",
                  "proof",
                  "signature"
                ],
                "publishes": "x-spike-v9:channel:response-query"
              }
            },
            "position": "top",
            "title": "Filters"
          },
          {
            "id": "viewControls",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-response-table",
              "widgetName": "x-view-controls",
              "config": {
                "columns": [
                  "respondent",
                  "submitted",
                  "proof",
                  "signature",
                  "totalBudget",
                  "version",
                  "hash",
                  "ein",
                  "source",
                  "reviewer",
                  "timeOnForm"
                ],
                "viewState": "x-spike-v9:user-scoped:saved-views",
                "actions": [
                  "export"
                ]
              }
            },
            "position": "top",
            "title": "Columns & views"
          },
          {
            "id": "table",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-response-table",
              "widgetName": "x-response-table",
              "config": {
                "consumes": "x-spike-v9:channel:response-query",
                "dataSource": "x-spike-v9:workspace:forms/:id/responses",
                "pagination": {
                  "pageSize": 12,
                  "total": 4218
                },
                "rowActions": [
                  "open-response",
                  "open-receipt"
                ]
              }
            },
            "position": "main",
            "title": "Responses"
          }
        ],
        "title": "Responses"
      }
    ],
    "entry": "responses"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
        "name": "x-cloud-stat-tiles",
        "category": "module",
        "version": "0.1.0",
        "status": "stable",
        "description": "Formspec Cloud product module x-cloud-stat-tiles.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "contributes": [
