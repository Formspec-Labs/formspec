      },
      {
        "name": "x-ceremony-evidence",
        "category": "widget",
        "version": "0.1.0",
        "status": "stable",
        "description": "Widget x-ceremony-evidence contributed by x-cloud-evidence-strip.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "widgetShape": {
          "tokenSlots": [
            {
