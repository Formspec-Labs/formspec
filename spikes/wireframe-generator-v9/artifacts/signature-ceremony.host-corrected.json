  "uiGraphPolicy": {
    "$formspecUiGraphPolicy": "0.1",
    "version": "1.0.0",
    "title": "Signature ceremony policy",
    "description": "Ceremony chrome is structurally immutable: tenant theming must not reach this route. The substrate has no way to assert that — see finding 6.",
    "targetSurface": {
      "url": "https://formspec.cloud/apps/ceremony/signature/surfaces/sign",
      "version": "1.0.0"
    },
    "routePolicies": [
      {
        "routeId": "ceremony",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      }
    ],
    "theme": {
      "assignments": [
        {
          "widgetRef": {
            "moduleId": "x-cloud-signature-capture",
            "widgetName": "x-signature-capture"
          },
          "slot": "accent",
          "token": "color.accent"
        },
        {
          "widgetRef": {
            "moduleId": "x-cloud-evidence-strip",
            "widgetName": "x-ceremony-evidence"
          },
          "slot": "surface",
          "token": "color.surface"
        }
      ]
    }
  },
  "slotMockupRegions": [
    {
      "slot": "ceremonyChrome",
      "slotType": "static-content",
      "mockupRegion": "immutable ceremony chrome — \"Receipt · Signature\", env id, cancel"
    },
    {
      "slot": "attestation",
      "slotType": "static-content",
      "mockupRegion": "attestation sentence with interpolated signer + party (authored as a frozen string — no interpolation contract)"
    },
    {
      "slot": "signatureCapture",
      "slotType": "module-widget",
      "mockupRegion": "draw/type/upload capture with ed25519 client-side hashing and Apply signature action"
    },
    {
      "slot": "evidenceStrip",
      "slotType": "module-widget",
      "mockupRegion": "time / IP / ID.me IAL2 evidence strip"
    },
    {
      "slot": "documentSummary",
      "slotType": "static-content",
      "mockupRegion": "document summary — parties, scope, compliance, open-full-document link"
    },
    {
      "slot": "signerTimeline",
      "slotType": "module-widget",
      "mockupRegion": "envelope panel + other-signers timeline with completion timestamps"
    }
  ]
