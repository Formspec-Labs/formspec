{
  "mockup": "surfaces/signature-ceremony.html",
  "family": "stateful-ceremony",
  "route": "/sign/:envelopeId",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/ceremony/signature/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "ceremony",
      "wanted": "ceremony",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/ceremony/signature",
    "title": "Sign — env_8Bm7n3",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/ceremony/signature/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/ceremony/signature/surfaces/sign",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-signature-capture",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-signer-timeline",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-evidence-strip",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "sign",
    "routes": [
      {
        "id": "ceremony",
        "path": "/sign/:envelopeId",
        "slots": [
          {
            "id": "ceremonyChrome",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "Sign as Diane Park · co-signatory",
              "level": 1
            },
            "position": "top",
            "title": "Ceremony"
          },
          {
            "id": "attestation",
            "slotType": "static-content",
            "binding": {
              "kind": "text",
              "content": "I, Diane Park, sign this Vendor Onboarding Agreement on behalf of Acme Industrial Supplies and certify that the information herein is accurate and complete to the best of my knowledge."
            },
            "position": "main",
            "title": "Attestation"
          },
          {
            "id": "signatureCapture",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-signature-capture",
              "widgetName": "x-signature-capture",
              "config": {
                "modes": [
                  "draw",
                  "type",
                  "upload"
                ],
                "commitment": "ed25519-client-side-hash",
                "definitionPin": "sha256:6d4a…ef91"
              }
            },
            "position": "main",
            "title": "Sign with your name"
          },
          {
            "id": "evidenceStrip",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-evidence-strip",
              "widgetName": "x-ceremony-evidence",
              "config": {
                "fields": [
                  "time",
                  "ip",
                  "identityAssurance"
                ],
                "dataSource": "x-spike-v9:host:ceremony-evidence"
              }
            },
            "position": "main",
            "title": "Evidence"
          },
          {
            "id": "documentSummary",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "What you're signing",
              "level": 2
            },
            "position": "right",
            "title": "What you're signing"
          },
          {
            "id": "signerTimeline",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-signer-timeline",
              "widgetName": "x-signer-timeline",
              "config": {
                "dataSource": "x-spike-v9:workspace:envelopes/:envelopeId/signers",
                "routing": "sequential"
              }
            },
            "position": "right",
            "title": "Other signers"
          }
        ],
        "title": "Sign"
      }
    ],
    "entry": "ceremony"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
        "name": "x-cloud-signature-capture",
