{
  "mockup": "surfaces/forms-index v3.html",
  "family": "collection-index",
  "route": "/o/:org/w/:ws/forms",
  "registryArm": "materialised",
  "declareRegistry": {
    "ok": true,
    "url": "urn:formspec:doc:5c5e7cec98013a1d:registry",
    "mintedBundleLocal": true
  },
  "routeClassOutcomes": [
    {
      "routeId": "index",
      "wanted": "operation",
      "verbOk": true,
      "persisted": true
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/forms-index",
    "title": "Forms",
    "definitions": [],
    "registries": [
      {
        "url": "urn:formspec:doc:5c5e7cec98013a1d:registry",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/forms-index/surfaces/forms",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-forms-collection",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-filter-bar",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-bulk-action-bar",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "forms",
    "routes": [
      {
        "id": "index",
        "path": "/o/:org/w/:ws/forms",
        "slots": [
          {
            "id": "headerStats",
            "slotType": "static-content",
            "binding": {
              "kind": "heading",
              "content": "Forms",
              "level": 1
            },
            "position": "top",
            "title": "Forms"
          },
          {
            "id": "stateTabs",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-filter-bar",
              "widgetName": "StateTabs",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms",
                "facets": [
                  {
                    "id": "state",
                    "values": [
                      "all",
                      "live",
                      "paused",
                      "draft",
                      "closed",
                      "archived"
                    ]
                  }
                ]
              }
            },
            "position": "top",
            "title": "State"
          },
          {
            "id": "filterBar",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-filter-bar",
              "widgetName": "FormsFilterBar",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms",
                "facets": [
                  {
                    "id": "deployment",
                    "values": [
                      "shared",
                      "regulated",
                      "dedicated",
                      "air-gap"
                    ]
                  },
                  {
                    "id": "owner",
                    "source": "x-spike-v9:workspace:members"
                  },
                  {
                    "id": "program",
                    "source": "x-spike-v9:workspace:programs"
                  }
                ],
                "search": true,
                "groupBy": [
                  "program",
                  "recent-activity"
                ]
              }
            },
            "position": "top",
            "title": "Filters"
          },
          {
            "id": "bulkActions",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-bulk-action-bar",
              "widgetName": "BulkActionBar",
              "config": {
                "actions": [
                  "pause",
                  "duplicate",
                  "move-to-program",
                  "add-tag",
                  "export",
                  "archive"
                ],
                "subject": "x-spike-v9:selection:forms"
              }
            },
            "position": "top",
            "title": "Bulk actions"
          },
          {
            "id": "formsList",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-forms-collection",
              "widgetName": "FormsCollection",
              "config": {
                "dataSource": "x-spike-v9:workspace:forms",
                "grouping": "program",
                "pinned": true,
                "columns": [
                  "title",
                  "state",
                  "window",
                  "owner",
                  "activeVersion",
                  "draftVersion",
                  "deployment",
                  "definitionId",
                  "tags",
                  "proofDistribution",
                  "completion",
                  "newDelta",
                  "lastActivity"
                ],
                "rowActions": [
                  "copy-link",
                  "preview",
                  "more"
                ],
                "emptyState": "x-spike-v9:state:no-forms"
              }
            },
            "position": "main",
            "title": "Forms"
          }
        ],
        "title": "Forms",
        "routeClass": "operation"
      }
    ],
    "entry": "index"
  },
  "registryDocument": null,
  "uiGraphPolicy": {
    "$formspecUiGraphPolicy": "0.1",
    "version": "1.0.0",
    "title": "Forms index policy",
    "targetSurface": {
      "url": "https://formspec.cloud/apps/console/forms-index/surfaces/forms",
      "version": "1.0.0"
    },
    "routePolicies": [
      {
        "routeId": "index",
        "a11y": {
          "landmark": "main",
          "keyboardNavigation": true
        }
      }
    ]
  },
  "slotMockupRegions": [
    {
      "slot": "headerStats",
      "slotType": "static-content",
      "mockupRegion": "header stat strip — 14 forms · 9 live · 1 closes this week · 26 824 responses"
    },
    {
      "slot": "stateTabs",
      "slotType": "module-widget",
      "mockupRegion": "state tab bar with per-state counts"
    },
    {
      "slot": "filterBar",
      "slotType": "module-widget",
      "mockupRegion": "search + removable filter chips + group-by/sort controls"
    },
    {
      "slot": "bulkActions",
      "slotType": "module-widget",
      "mockupRegion": "bulk-selection action bar (\"2 selected across 1 program\")"
    },
    {
      "slot": "formsList",
      "slotType": "module-widget",
      "mockupRegion": "pinned + program-grouped form rows with proof bars, completion meters, row actions"
    }
  ]
}