{
  "mockup": "surfaces/onboarding.html",
  "family": "wizard",
  "route": "/onboarding",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/console/onboarding/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "organization",
      "wanted": "intake",
      "verbOk": true,
      "persisted": false
    },
    {
      "routeId": "tier",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    },
    {
      "routeId": "region",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    },
    {
      "routeId": "first-form",
      "wanted": "operation",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": false,
    "error": "VALIDATION — Surface 'wizard' is not publishable.",
    "diagnostics": [
      {
        "code": "SURFACE-ROUTE-UNREACHABLE",
        "message": "Surface route 'tier' is not reachable from entry 'organization'."
      },
      {
        "code": "SURFACE-ROUTE-UNREACHABLE",
        "message": "Surface route 'region' is not reachable from entry 'organization'."
      },
      {
        "code": "SURFACE-ROUTE-UNREACHABLE",
        "message": "Surface route 'first-form' is not reachable from entry 'organization'."
      }
    ]
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/console/onboarding",
    "title": "Get started",
    "definitions": [
      {
        "url": "https://formspec.cloud/definitions/onboarding-org",
        "version": "1.0.0"
      }
    ],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/console/onboarding/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/console/onboarding/surfaces/wizard",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-step-rail",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-tier-cards",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-region-picker",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-form-genesis",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "wizard",
    "routes": [
      {
        "id": "organization",
        "path": "/onboarding/organization",
        "slots": [
          {
            "id": "stepRail",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-step-rail",
              "widgetName": "x-step-rail",
              "config": {
                "steps": [
                  "account",
                  "organization",
                  "tier",
                  "region",
                  "first-form",
                  "publish"
                ],
                "current": "organization",
                "estimate": "7 minutes"
              }
            },
            "position": "left",
            "title": "Steps"
          }
        ],
        "title": "Tell us about your organization"
      },
      {
        "id": "tier",
        "path": "/onboarding/tier",
        "slots": [
          {
            "id": "tierCards",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-tier-cards",
              "widgetName": "x-tier-comparison",
              "config": {
                "dataSource": "x-spike-v9:catalog:deployment-tiers",
                "tiers": [
                  "shared",
                  "regulated",
                  "dedicated",
                  "air-gap"
                ],
                "recommended": "regulated"
              }
            },
            "position": "main",
            "title": "Deployment tier"
          }
        ],
        "title": "Pick a deployment tier"
      },
      {
        "id": "region",
        "path": "/onboarding/region",
        "slots": [
          {
            "id": "regionPicker",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-region-picker",
              "widgetName": "x-region-picker",
              "config": {
                "dataSource": "x-spike-v9:catalog:regions",
                "irreversibleAfter": "first-publish"
              }
            },
            "position": "main",
            "title": "Region"
          }
        ],
        "title": "Where should your data live?"
      },
      {
        "id": "first-form",
        "path": "/onboarding/first-form",
        "slots": [
          {
            "id": "genesis",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-form-genesis",
              "widgetName": "x-form-genesis",
              "config": {
                "paths": [
                  "template",
                  "import",
                  "prompt-to-form",
                  "blank"
                ],
                "dataSource": "x-spike-v9:catalog:templates"
              }
            },
            "position": "main",
            "title": "First form"
          }
        ],
        "title": "Create your first form"
      }
    ],
    "entry": "organization"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
        "name": "x-cloud-step-rail",
        "category": "module",
        "version": "0.1.0",
        "status": "stable",
        "description": "Formspec Cloud product module x-cloud-step-rail.",
        "compatibility": {
