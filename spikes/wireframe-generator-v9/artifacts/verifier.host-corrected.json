{
  "mockup": "surfaces/verifier.html",
  "family": "interactive-tool",
  "route": "/verify",
  "registryArm": "host-corrected",
  "declareRegistry": {
    "ok": true,
    "url": "https://formspec.cloud/apps/trust/verifier/registries/product-modules"
  },
  "routeClassOutcomes": [
    {
      "routeId": "verify",
      "wanted": "verification",
      "verbOk": true,
      "persisted": false
    }
  ],
  "surfaceExport": {
    "publishable": true,
    "diagnostics": []
  },
  "manifest": {
    "$formspecBundle": "2.0",
    "version": "1.0.0",
    "id": "https://formspec.cloud/apps/trust/verifier",
    "title": "Verifier",
    "definitions": [],
    "registries": [
      {
        "url": "https://formspec.cloud/apps/trust/verifier/registries/product-modules",
        "version": "1.0.0"
      }
    ],
    "surfaces": [
      {
        "url": "https://formspec.cloud/apps/trust/verifier/surfaces/verify",
        "version": "1.0.0"
      }
    ],
    "modules": [
      {
        "id": "x-cloud-artifact-input",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-verification-result",
        "version": "0.1.0"
      },
      {
        "id": "x-cloud-computation-log",
        "version": "0.1.0"
      }
    ],
    "sessions": []
  },
  "surface": {
    "$formspecSurface": "0.1",
    "id": "verify",
    "routes": [
      {
        "id": "verify",
        "path": "/verify",
        "slots": [
          {
            "id": "assurance",
            "slotType": "static-content",
            "binding": {
              "kind": "text",
              "content": "Runs entirely in this tab — no data leaves your browser. The verifier recomputes the response hash, checks the signature chain, and confirms the Trellis anchor locally, without contacting Formspec Cloud."
            },
            "position": "top",
            "title": "Verify a Receipt"
          },
          {
            "id": "receiptInput",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-artifact-input",
              "widgetName": "x-receipt-input",
              "config": {
                "accepts": [
                  "application/json",
                  ".receipt.json"
                ],
                "schema": "https://formspec.org/schemas/receipt/1.0",
                "persist": false,
                "publishes": "x-spike-v9:channel:receipt-bytes"
              }
            },
            "position": "main",
            "title": "Receipt input"
          },
          {
            "id": "verifyAction",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-verification-result",
              "widgetName": "x-verify-button",
              "config": {
                "consumes": "x-spike-v9:channel:receipt-bytes",
                "executor": "x-spike-v9:client-only",
                "emits": "x-spike-v9:channel:verification-result"
              }
            },
            "position": "main",
            "title": "Verify locally"
          },
          {
            "id": "result",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-verification-result",
              "widgetName": "x-verification-result",
              "config": {
                "consumes": "x-spike-v9:channel:verification-result",
                "checks": [
                  "response-hash",
                  "definition-pin",
                  "signature-chain",
                  "anchor-present",
                  "inclusion-proof",
                  "schema-conformance"
                ]
              }
            },
            "position": "main",
            "title": "Verification result"
          },
          {
            "id": "computationLog",
            "slotType": "module-widget",
            "binding": {
              "moduleId": "x-cloud-computation-log",
              "widgetName": "x-computation-log",
              "config": {
                "consumes": "x-spike-v9:channel:verification-result",
                "streaming": true
              }
            },
            "position": "bottom",
            "title": "Computation log"
          }
        ],
        "title": "Verify a Receipt"
      }
    ],
    "entry": "verify"
  },
  "registryDocument": {
    "$formspecRegistry": "1.0",
    "publisher": {
      "name": "Formspec Cloud (host-authored, no MCP verb)"
    },
    "published": "2026-07-26T00:00:00Z",
    "entries": [
      {
        "name": "x-cloud-artifact-input",
        "category": "module",
        "version": "0.1.0",
        "status": "stable",
        "description": "Formspec Cloud product module x-cloud-artifact-input.",
        "compatibility": {
          "formspecVersion": ">=1.0.0"
        },
        "contributes": [
          "x-receipt-input"
        ]
      },
      {
        "name": "x-receipt-input",
        "category": "widget",
        "version": "0.1.0",
        "status": "stable",
        "description": "Widget x-receipt-input contributed by x-cloud-artifact-input.",
        "compatibility": {
