                    "binding": {
                      "moduleId": "x-cloud-stat-tiles",
                      "widgetName": "KpiTiles",
                      "config": {
                        "dataSource": "x-spike-v9:workspace:metrics",
                        "tiles": [
                          "responses-30d",
                          "proof-ready",
                          "awaiting-signature",
                          "anchor-stalled"
                        ]
                      }
                    },
                    "position": "main",
                    "title": "Key metrics"
                  },
                  {
                    "id": "proofHealth",
                    "slotType": "module-widget",
                    "binding": {
                      "moduleId": "x-cloud-proof-distribution",
                      "widgetName": "ProofHealth",
                      "config": {
                        "dataSource": "x-spike-v9:workspace:proof-distribution",
                        "categories": [
                          "proof_ready",
                          "proof_pending",
                          "anchor_stalled",
                          "accepted"
                        ],
                        "window": "7d"
                      }
                    },
                    "position": "main",
                    "title": "Proof health"
                  },
                  {
                    "id": "formsTable",
                    "slotType": "module-widget",
                    "binding": {
                      "moduleId": "x-cloud-forms-collection",
                      "widgetName": "FormsCollection",
                      "config": {
                        "dataSource": "x-spike-v9:workspace:forms",
                        "columns": [
                          "form",
                          "responses7d",
                          "proofDistribution",
                          "lastResponse",
                          "deployment",
                          "state"
                        ]
                      }
                    },
                    "position": "main",
                    "title": "Forms"
                  },
                  {
                    "id": "activity",
                    "slotType": "module-widget",
                    "binding": {
                      "moduleId": "x-cloud-activity-feed",
