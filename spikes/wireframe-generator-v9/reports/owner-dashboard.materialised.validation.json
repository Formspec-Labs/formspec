                          "signer",
                          "webhook"
                        ]
                      }
                    },
                    "position": "right",
                    "title": "Activity"
                  },
                  {
                    "id": "posture",
                    "slotType": "static-content",
                    "binding": {
                      "kind": "heading",
                      "content": "Posture",
                      "level": 2
                    },
                    "position": "right",
                    "title": "Posture"
                  },
                  {
                    "id": "recentReceipts",
                    "slotType": "module-widget",
                    "binding": {
                      "moduleId": "x-cloud-activity-feed",
