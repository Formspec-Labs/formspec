{
  "$formspecSurface": "0.1",
  "id": "respondent",
  "entry": "apply",
  "routes": [
    {
      "id": "apply",
      "path": "/apply",
      "title": "About your household",
      "transitions": [
        {
          "trigger": "submit",
          "to": "applyMoney"
        }
      ],
      "routeClass": "intake",
      "slots": [
        {
          "id": "applyJourney",
          "slotType": "experience-unit",
          "binding": {
            "unitRef": "applyForHelp"
          },
          "title": "Where you are"
        },
        {
          "id": "applyChrome",
          "slotType": "module-widget",
          "binding": {
            "moduleId": "x-formspec-tenant-chrome",
            "widgetName": "x-intake-banner"
          }
        },
        {
          "id": "applyForm",
          "slotType": "definition-form",
          "binding": {
            "definitionRef": "https://benefits.example.gov/apps/assistance/definitions/rent-assistance"
          },
          "title": "About your household"
        },
        {
          "id": "applyReassurance",
          "slotType": "static-content",
          "binding": {
            "kind": "text",
            "content": "You can apply even if you have already received help this year."
          },
          "title": "Before you start"
        }
      ]
    },
    {
      "id": "applyMoney",
      "path": "/apply/money",
      "title": "Rent and income",
      "transitions": [
        {
          "trigger": "submit",
          "to": "certify"
        }
      ],
      "slots": [
        {
          "id": "moneyForm",
          "slotType": "definition-form",
          "binding": {
            "definitionRef": "https://benefits.example.gov/apps/assistance/definitions/rent-assistance"
          },
          "title": "Rent and income"
        },
        {
          "id": "moneyChrome",
          "slotType": "module-widget",
          "binding": {
            "moduleId": "x-formspec-tenant-chrome",
            "widgetName": "x-intake-banner"
          }
        }
      ]
    },
    {
      "id": "certify",
      "path": "/certify",
      "title": "Sign your declaration",
      "transitions": [
        {
          "trigger": "submit",
          "to": "receipt"
        }
      ],
      "routeClass": "ceremony",
      "slots": [
        {
          "id": "certifyJourney",
          "slotType": "static-content",
          "binding": {
            "kind": "heading",
            "content": "Your declaration",
            "level": 1
          },
          "title": "Your declaration"
        },
        {
          "id": "certifyChrome",
          "slotType": "module-widget",
          "binding": {
            "moduleId": "x-formspec-tenant-chrome",
            "widgetName": "x-ceremony-frame"
          }
        }
      ]
    },
    {
      "id": "receipt",
      "path": "/receipt/:caseRef",
      "title": "Your receipt",
      "routeClass": "proof",
      "slots": [
        {
          "id": "receiptJourney",
          "slotType": "static-content",
          "binding": {
            "kind": "heading",
            "content": "What you submitted",
            "level": 1
          },
          "title": "What you submitted"
        },
        {
          "id": "receiptChrome",
          "slotType": "module-widget",
          "binding": {
            "moduleId": "x-formspec-tenant-chrome",
            "widgetName": "x-receipt-panel"
          }
        }
      ]
    }
  ]
}
