{
  "name": "formspec-surface-preview-host",
  "private": true,
  "version": "0.12.0",
  "description": "Fixed browser host for data-only Surface preview bundles",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4184 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:generic-host": "node scripts/check-generic-host.mjs",
    "test": "node --test ../reasoning-review.test.mjs && npm run check:generic-host && npm run typecheck"
  },
  "dependencies": {
    "@formspec-org/assist": "file:../../../packages/formspec-assist",
    "@formspec-org/engine": "file:../../../packages/formspec-engine",
    "@formspec-org/layout": "file:../../../packages/formspec-layout",
    "@formspec-org/outcome-verification": "file:../../../packages/formspec-outcome-verification",
    "@formspec-org/react": "file:../../../packages/formspec-react",
    "@formspec-org/surface": "file:../../../packages/formspec-surface",
    "@formspec-org/surface-react": "file:../../../packages/formspec-surface-react",
    "@formspec-org/types": "file:../../../packages/formspec-types",
    "@preact/signals-core": "^1.8.0",
    "ajv": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
