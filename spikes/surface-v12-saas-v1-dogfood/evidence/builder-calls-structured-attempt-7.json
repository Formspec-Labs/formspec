    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "forms",
        "path": "/app/forms",
        "title": "Forms",
        "route_class": "intake"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "formDetail",
        "path": "/app/forms/{formId}",
        "params": [
          {
            "name": "formId",
            "type": "string",
            "description": "Tenant-scoped published or draft form identifier.",
            "example": "frm_annual-intake"
          }
        ],
        "title": "Form detail",
        "route_class": "intake"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "formPreview",
        "path": "/app/forms/preview",
        "title": "Hosted form preview",
        "route_class": "intake"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "responses",
        "path": "/app/responses",
        "title": "Responses and exports",
        "route_class": "proof"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "signatures",
        "path": "/app/signatures",
        "title": "Signature workflows",
        "route_class": "ceremony"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "integrations",
        "path": "/app/integrations",
        "title": "API and webhooks",
        "route_class": "operation"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "admin",
        "path": "/app/admin",
