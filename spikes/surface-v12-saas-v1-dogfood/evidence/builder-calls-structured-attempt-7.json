    {
      "name": "formspec_wireframes_edit_registry",
      "arguments": {
        "operation": "declare",
        "version": "0.12.0"
      }
    },
    {
      "name": "formspec_wireframes_edit_registry",
      "arguments": {
        "operation": "add_module",
        "module_id": "x-saas-shell",
        "module_version": "0.12.0",
        "entry_version": "0.12.0",
        "status": "stable",
        "description": "Reusable SaaS route panel for content, status, data, and navigation actions.",
        "contributes": [
          "x-saas-route-panel"
        ],
        "formspec_version": "2.4"
      }
    },
    {
      "name": "formspec_wireframes_edit_registry",
      "arguments": {
        "operation": "add_widget",
        "version": "0.12.0",
        "contribution_id": "x-saas-route-panel",
        "widget_name": "SaaSRoutePanel",
        "description": "Reusable panel mounted on every SaaS route.",
        "widget_shape": {
          "props": {
            "title": {
              "type": "string"
            },
            "featureState": {
              "type": "string"
            }
          },
          "dataInputs": [
            {
              "name": "primaryData",
              "required": false
            }
          ],
          "actionOutputs": [
            {
              "name": "review"
            },
            {
              "name": "saveDraft"
            },
            {
              "name": "submit"
            },
            {
              "name": "evidence"
            },
            {
              "name": "openForms"
            },
            {
              "name": "startOnboarding"
            },
            {
              "name": "openResponses"
            },
            {
              "name": "openIntegrations"
            },
            {
              "name": "openAdmin"
            },
            {
              "name": "openBilling"
            },
            {
              "name": "openPublicRespond"
            }
          ],
          "childrenPolicy": "none",
          "fallback": "Render the route title and feature-state text when module loading fails."
        }
      }
    },
    {
      "name": "formspec_wireframes_materialize_data_sources",
      "arguments": {
        "catalog_id": "https://formspec.cloud/data-sources/saas-v1",
        "version": "0.12.0",
        "title": "Formspec Cloud SaaS data",
        "description": "Tenant-scoped live data for responses, billing, support, status, and trust views.",
        "sources": [
          {
            "id": "query:responses",
            "kind": "query-result",
            "owner": "host",
            "scope": "route",
            "availability": {
              "level": "route",
              "routeRef": "responses",
              "surfaceRef": "https://formspec.cloud/app"
            },
            "runtime": {
              "delivery": "live",
              "cache": {
                "mode": "subscribe",
                "staleAfter": "PT30S"
              },
              "authorizationBoundary": "host",
              "failureMode": "degraded-widget",
              "provenance": {
                "kind": "query-result",
                "source": "tenant response and proof query"
              }
            },
            "schema": {
              "type": "object",
              "properties": {
                "responses": {
                  "type": "array"
                },
                "exportFormats": {
                  "type": "array"
                },
                "proofStatus": {
                  "type": "string"
                }
              }
            },
            "description": "Tenant responses, export options, and verifier-backed proof status."
          },
          {
            "id": "host:billing",
            "kind": "host-state",
            "owner": "host",
            "scope": "route",
            "availability": {
              "level": "route",
              "routeRef": "billing",
              "surfaceRef": "https://formspec.cloud/app"
            },
            "runtime": {
              "delivery": "live",
              "cache": {
                "mode": "subscribe",
                "staleAfter": "PT60S"
              },
              "authorizationBoundary": "host",
              "failureMode": "stale-ok",
              "provenance": {
                "kind": "host-state",
                "source": "billing and entitlement service"
              }
            },
            "schema": {
              "type": "object",
              "properties": {
                "plan": {
                  "type": "string"
                },
                "usage": {
                  "type": "object"
                },
                "limits": {
                  "type": "object"
                },
                "billingStatus": {
                  "type": "string"
                }
              }
            },
            "description": "Current plan, usage, limits, billing state, and entitlements."
          },
          {
            "id": "resource:support-trust",
            "kind": "document-resource",
            "owner": "host",
            "scope": "route",
            "availability": {
              "level": "route",
              "routeRef": "supportTrust",
              "surfaceRef": "https://formspec.cloud/app"
            },
            "runtime": {
              "delivery": "snapshot",
              "cache": {
                "mode": "snapshot",
                "staleAfter": "PT5M"
              },
              "authorizationBoundary": "host",
              "failureMode": "stale-ok",
              "provenance": {
                "kind": "document-resource",
                "source": "status, incident, support, and trust services"
              }
            },
            "schema": {
              "type": "object",
              "properties": {
                "serviceStatus": {
                  "type": "array"
                },
                "incidents": {
                  "type": "array"
                },
                "supportAccess": {
                  "type": "array"
                },
                "trustDocuments": {
                  "type": "array"
                }
              }
            },
            "description": "Customer-visible service health, incidents, support access, and trust documents."
          }
        ]
      }
    },
    {
      "name": "formspec_wireframes_add_experience_unit",
      "arguments": {
        "unit_id": "respondJourney",
        "kind": "data-entry",
        "title": "Complete, review, and submit a response",
        "actor_ref": "publicRespondent",
        "task_refs": [
          "enterDetails",
          "reviewResponse",
          "submitResponse",
          "receiveReceipt"
        ]
      }
    },
    {
      "name": "formspec_wireframes_bind_slot",
      "arguments": {
        "route_id": "dashboard",
        "slot_id": "dashboardSummary",
        "position": "main",
        "title": "Customer dashboard",
        "slot_type": "static-content",
        "binding": {
          "kind": "text",
          "content": "LIVE — Workspace summary, published forms, responses, signatures, and plan usage. Connected navigation includes Forms, Responses, Integrations, Administration, Billing, Support, and public completion."
        }
      }
    },
    {
      "name": "formspec_wireframes_bind_slot",
      "arguments": {
        "route_id": "onboarding",
        "slot_id": "onboardingChecklist",
        "position": "main",
        "title": "Organization setup",
        "slot_type": "static-content",
        "binding": {
          "kind": "text",
          "content": "LIVE — Create organization, workspace, production and sandbox environments, and invite teammates. SSO/SAML/SCIM is ASSISTED with visible request status."
