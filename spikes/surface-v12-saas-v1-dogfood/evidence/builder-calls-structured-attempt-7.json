    {
      "name": "formspec_wireframes_bind_slot",
      "arguments": {
        "route_id": "supportTrust",
        "slot_id": "supportTrustHub",
        "position": "main",
        "title": "Support, status, and trust",
        "slot_type": "static-content",
        "binding": {
          "kind": "text",
          "content": "LIVE — Status, support, incident records, trust center, and subprocessors. Dedicated review is ASSISTED; active-active is DISABLED."
        }
      }
    },
    {
      "name": "formspec_wireframes_bind_slot",
      "arguments": {
        "route_id": "publicRespond",
        "slot_id": "publicSubmission",
        "position": "main",
        "title": "Public submission",
        "slot_type": "static-content",
        "binding": {
          "kind": "text",
          "content": "LIVE — Anonymous mobile completion with validation, review, submit, notices, and confirmation. No respondent account or dashboard."
        }
      }
    },
    {
      "name": "formspec_wireframes_bind_slot",
      "arguments": {
        "route_id": "publicReceipt",
        "slot_id": "receiptStatus",
        "position": "main",
        "title": "Receipt and verification",
        "slot_type": "static-content",
        "binding": {
          "kind": "text",
          "content": "LIVE — Submission receipt and verifier-backed proof status. Hosted general verification is DISABLED; documented CLI/library verification remains available."
        }
      }
    },
    {
      "name": "formspec_wireframes_bind_slot",
