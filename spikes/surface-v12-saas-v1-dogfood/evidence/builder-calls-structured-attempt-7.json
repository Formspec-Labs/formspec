      "name": "formspec_wireframes_bind_slot",
      "arguments": {
        "route_id": "admin",
        "slot_id": "adminControls",
        "position": "main",
        "title": "Organization administration",
        "slot_type": "static-content",
        "binding": {
          "kind": "text",
