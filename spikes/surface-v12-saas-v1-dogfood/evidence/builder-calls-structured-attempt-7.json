{
  "calls": [
    {
      "name": "formspec_wireframes_start_app",
      "arguments": {
        "app_id": "https://formspec.cloud/apps/saas-v1",
        "title": "Formspec Cloud",
        "version": "0.12.0",
        "surface_url": "https://formspec.cloud/app",
        "surface_version": "0.12.0",
        "brief": "Managed hosted-forms and signature SaaS. Customer and administrator work stays in the app; public respondents use a short mobile-first flow. Every exposed capability is live, assisted, preview, or disabled."
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "dashboard",
        "path": "/app",
        "title": "Dashboard",
        "route_class": "operation"
      }
    },
    {
      "name": "formspec_wireframes_add_route",
      "arguments": {
        "route_id": "onboarding",
        "path": "/app/get-started",
        "title": "Set up organization",
        "route_class": "authentication"
