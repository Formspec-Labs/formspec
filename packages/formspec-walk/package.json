{
  "name": "@formspec-org/walk",
  "description": "The Definition walk: Playwright + Guidepup checks derived from a Definition, Locale and Theme, and an axe-core accessibility check of the reference renderer — run generically, emitted as a readable spec, or served",
  "version": "2.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-walk"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "formspec-walk": "bin/formspec-walk.mjs"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc && cp src/virtual-build.cjs src/virtual-build.d.cts dist/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@formspec-org/engine": "^2.1.0",
    "@formspec-org/layout": "^2.1.0",
    "@formspec-org/types": "^0.2.1",
    "@formspec-org/webcomponent": "^2.1.0",
    "@guidepup/virtual-screen-reader": "^0.32.1"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.10.0",
    "@guidepup/playwright": ">=0.19.0",
    "@playwright/test": ">=1.42.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@guidepup/playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
