{
  "name": "@formspec-org/webcomponent",
  "description": "Web component renderer (<formspec-render>) with pluggable component registry",
  "version": "2.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-webcomponent"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default-theme": "./dist/default-theme.json",
    "./formspec-layout.css": "./dist/formspec-layout.css",
    "./formspec-default.css": "./dist/formspec-default.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/copy-layout-css-assets.mjs src dist ../formspec-layout/src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@formspec-org/engine": "^2.0.1",
    "@formspec-org/layout": "^2.0.1",
    "@formspec-org/types": "^0.2.0"
  },
  "devDependencies": {
    "happy-dom": "^17.6.1",
    "typescript": "^5.0.0"
  }
}
