{
  "name": "@formspec-org/surface-bundle-signing",
  "description": "Signed Surface-bundle preimage, verification, publisher trust, and release admission policy",
  "version": "2.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-surface-bundle-signing"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
