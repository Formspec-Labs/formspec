{
  "name": "@formspec-org/surface",
  "description": "Renderer-independent Surface shell — reads a bundle export's routes and slots and plans a navigable app",
  "version": "2.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-surface"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@formspec-org/app-graph": "^2.1.0",
    "@formspec-org/layout": "^2.1.0",
    "@formspec-org/types": "^0.2.1",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
