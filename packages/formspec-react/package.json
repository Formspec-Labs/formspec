{
  "name": "@formspec-org/react",
  "description": "React hooks and auto-renderer for Formspec — use any component library with FormEngine",
  "version": "2.1.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs",
      "default": "./dist/hooks.js"
    },
    "./semantic-controls": {
      "types": "./dist/semantic-controls.d.ts",
      "import": "./dist/semantic-controls.js",
      "require": "./dist/semantic-controls.cjs",
      "default": "./dist/semantic-controls.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@preact/signals-core": "^1.8.0",
    "@formspec-org/engine": "^2.0.2",
    "@formspec-org/layout": "^2.0.2",
    "@formspec-org/types": "^0.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@formspec-org/engine": "*",
    "@formspec-org/layout": "*",
    "@formspec-org/types": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "axe-core": "4.13.0",
    "happy-dom": "^17.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "canonicalize": "^3.0.0",
    "marked": "^15.0.7",
    "sanitize-html": "^2.14.0"
  }
}
