{
  "name": "@formspec-org/react",
  "description": "React hooks and auto-renderer for Formspec \u2014 use any component library with FormEngine",
  "version": "2.1.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./semantic-controls": {
      "import": {
        "types": "./dist/semantic-controls.d.ts",
        "default": "./dist/semantic-controls.js"
      },
      "require": {
        "types": "./dist/semantic-controls.d.cts",
        "default": "./dist/semantic-controls.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:consumer": "vitest run tests/cjs-smoke.test.ts tests/esm-smoke.test.ts",
    "lint:publish": "publint --strict && attw --pack . --profile node16",
    "test:packed": "npm run lint:publish && node scripts/test-packed.mjs",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@formspec-org/engine": "^2.0.2",
    "@formspec-org/layout": "^2.0.2",
    "@formspec-org/types": "^0.2.0",
    "@preact/signals-core": "^1.8.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@formspec-org/engine": "*",
    "@formspec-org/layout": "*",
    "@formspec-org/types": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "axe-core": "4.13.0",
    "happy-dom": "^17.6.1",
    "publint": "0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "canonicalize": "^3.0.0",
    "marked": "^15.0.7",
    "sanitize-html": "^2.14.0"
  }
}
