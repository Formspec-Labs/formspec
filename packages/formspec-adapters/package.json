{
  "name": "@formspec-org/adapters",
  "description": "Render adapter library — design-system-specific DOM implementations for formspec-webcomponent",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Formspec-Labs/formspec.git",
    "directory": "packages/formspec-adapters"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "formspec-adapter-css": "scripts/build-css.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-formspec-core.css": "./tailwind-formspec-core.css",
    "./uswds-base.css": "./uswds-base.css",
    "./uswds-formspec.css": "./uswds-formspec.css",
    "./uswds.classes.js": {
      "types": "./uswds.classes.d.ts",
      "default": "./uswds.classes.js"
    },
    "./uswds-base.scss": "./src/uswds/uswds-base.scss"
  },
  "files": [
    "dist",
    "tailwind-formspec-core.css",
    "uswds-base.css",
    "uswds-formspec.css",
    "uswds.classes.js",
    "uswds.classes.d.ts",
    "src/uswds/uswds-base.scss"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "clean": "rm -rf dist tailwind-formspec-core.css uswds-base.css uswds-formspec.css uswds.classes.js uswds.classes.d.ts",
    "prebuild": "npm run clean && npm run build:css",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@formspec-org/webcomponent": "^2.0.0",
    "@preact/signals-core": "^1.6.0",
    "@uswds/uswds": "^3.11.0",
    "sass": "^1.86.0"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.8.0",
    "@uswds/uswds": "^3.11.0",
    "@formspec-org/webcomponent": "*",
    "happy-dom": "^17.6.1",
    "typescript": "^5.0.0",
    "sass": "^1.86.0"
  },
  "peerDependenciesMeta": {
    "@uswds/uswds": {
      "optional": true
    },
    "sass": {
      "optional": true
    }
  }
}
